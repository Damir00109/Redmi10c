[Unit]
Description=Start Qualcomm modem remoteproc (PAS)
DefaultDependencies=no
After=qrtr-ns.service rmtfs.service tqftpserv.service
Requires=qrtr-ns.service rmtfs.service tqftpserv.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/qcom-modem-start.sh

[Install]
WantedBy=sysinit.target
