[Unit]
Description=GNSS keep-alive (hold gnss-share open so the engine can fix)
Documentation=man:mmcli(1)
After=gnss-share.service
Wants=gnss-share.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/gnss-keepalive
Restart=always
RestartSec=5

# Не включается в загрузку: его поднимает rain-gps-start.sh в конце
# провижининга (после того как применён A-GPS конфиг и перезапущен MM).
[Install]
