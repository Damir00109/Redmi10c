[Unit]
Description=PulseAudio Sound System
After=bluetooth.service dbus.service
Wants=bluetooth.service dbus.service

[Service]
Type=simple
# NOTE: --disallow-module-loading must NOT be used here: module-bluez5-discover
# loads module-bluez5-device dynamically when a Bluetooth audio device
# connects, and the flag makes that fail with
# "Failed to load module for device ..." -> no BT sink ever appears.
ExecStart=/usr/bin/pulseaudio --system --disallow-exit
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
