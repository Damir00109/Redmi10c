#!/bin/sh
# Prepare the Snapdragon Sensor Core (SSC) environment for hexagonrpcd.
#
# Ported from the postmarketOS image (Alpine) to Ubuntu.  The binaries come
# from that image too: hexagonrpcd is a musl build, so it is run with the musl
# loader from /usr/lib/ld-musl-aarch64.so.1 and the libraries from
# /usr/lib/musl (see fetch-pmos-sensors.sh).  Never write through /lib --
# on Ubuntu it is a symlink to usr/lib and clobbering it breaks every binary.
set -u

R=/usr/share/qcom/sm6225/Xiaomi/rain
PERSIST_MP=/mnt/persist

log() { echo "sensors-setup: $*"; }

find_part() {
	for u in /sys/class/block/*/uevent; do
		[ -f "$u" ] || continue
		[ "$(sed -n 's/^PARTNAME=//p' "$u")" = "$1" ] || continue
		d=$(basename "$(dirname "$u")")
		case "$d" in loop*|ram*|zram*) continue ;; esac
		echo "/dev/$d"; return 0
	done
	return 1
}

# The SNS registry lives on the persist partition.
mkdir -p "$PERSIST_MP"
if ! mountpoint -q "$PERSIST_MP"; then
	PERSIST=$(find_part persist)
	if [ -n "$PERSIST" ]; then
		mount -o ro "$PERSIST" "$PERSIST_MP" 2>/dev/null
		log "persist mounted from $PERSIST"
	else
		log "persist partition not found — sensors registry stays empty"
	fi
fi

if [ -d "$PERSIST_MP/sensors/registry/registry" ]; then
	mkdir -p "$R/sensors/registry"
	cp -a "$PERSIST_MP/sensors/registry/registry/." "$R/sensors/registry/" 2>/dev/null
	cp -a "$PERSIST_MP/sensors/registry/sns_reg_config" "$R/sensors/sns_reg.conf" 2>/dev/null
	cp -a "$PERSIST_MP/sensors/registry/sns_reg_version" "$R/sensors/" 2>/dev/null
	cp -a "$PERSIST_MP/sensors/sensors_list.txt" "$R/sensors/" 2>/dev/null
	# hexagonrpcd 0.5.0 serves this directory as both /persist and
	# /mnt/vendor/persist itself, so one readable copy is enough: persist
	# is mode 600 owned by uid 1000 and the daemon runs as fastrpc.
	log "registry staged: $(ls "$R/sensors/registry" 2>/dev/null | wc -l) files"
fi
printf 'END:AP\n' > "$R/sensors/sns_reg_ctrl"

# hexagonrpcd runs as the unprivileged fastrpc user.
chmod -R a+rX "$R"
chown -R fastrpc:fastrpc "$R/sensors" 2>/dev/null || true

# socinfo files the sensor PD reads.  soc_id/revision come from the kernel
# (drivers/soc/qcom/socinfo.c -> /sys/devices/soc0); the platform fields are
# not exposed by the socinfo driver on this SoC, so they stay literal.
mkdir -p "$R/socinfo"
cat /sys/devices/soc0/soc_id   2>/dev/null > "$R/socinfo/soc_id"   || echo 518 > "$R/socinfo/soc_id"
cat /sys/devices/soc0/revision 2>/dev/null > "$R/socinfo/revision" || echo 1.0 > "$R/socinfo/revision"
echo bengal  > "$R/socinfo/hw_platform"
echo fog     > "$R/socinfo/platform_subtype"
echo 0       > "$R/socinfo/platform_subtype_id"
echo 0x10000 > "$R/socinfo/platform_version"

# hexagonrpcd 0.5.0 builds /mnt/vendor/persist, /persist, /system/vendor and
# /sys/devices/soc0 inside its virtual filesystem, so no host-side symlink is
# needed any more.  Only the LCM type is still read straight from the root.
[ -f /ro.boot.lcmtype ] || echo 1 > /ro.boot.lcmtype

# fastrpc is built-in (=y) since 2026-10-18, so /dev/fastrpc-adsp appears
# without loading anything from userspace.
i=0
while [ "$i" -lt 20 ] && [ ! -e /dev/fastrpc-adsp ]; do sleep 1; i=$((i + 1)); done
log "fastrpc device: $([ -e /dev/fastrpc-adsp ] && echo yes || echo no) (waited ${i}s)"
log "done"
