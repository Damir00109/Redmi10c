[Unit]
Description=Rain WiFi firmware startup and NetworkManager handoff
After=local-fs.target rain-stable-boot.service
Before=NetworkManager.service wpa_supplicant.service network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/rain-wifi-nm-start.sh
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
