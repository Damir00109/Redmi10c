[Unit]
Description=USB RNDIS network configuration
After=adbd.service
Wants=adbd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c 'for i in $(seq 1 30); do ip link show usb0 >/dev/null 2>&1 && break; sleep 0.5; done; ip addr flush dev usb0 2>/dev/null; ip addr add 10.0.0.2/24 dev usb0; ip link set usb0 up'
ExecStop=/bin/bash -c 'ip addr flush dev usb0 2>/dev/null; ip link set usb0 down 2>/dev/null'

[Install]
WantedBy=multi-user.target
