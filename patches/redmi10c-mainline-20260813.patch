 	msm_pinctrl_setup_pm_reset(pctrl);
 
-	pctrl->irq = platform_get_irq(pdev, 0);
-	if (pctrl->irq < 0)
-		return pctrl->irq;
+	/* Optional: rain/khaje bisect — pinmux without summary IRQ (irq storm / BACK_FB). */
+	pctrl->irq = platform_get_irq_optional(pdev, 0);
+	if (pctrl->irq == -EPROBE_DEFER)
+		return -EPROBE_DEFER;
 
 	pctrl->desc.owner = THIS_MODULE;
 	pctrl->desc.pctlops = &msm_pinctrl_ops;
@@ -1607,13 +1661,17 @@ int msm_pinctrl_probe(struct platform_device *pdev,
 			return ret;
 	}
 
-	ret = msm_gpio_init(pctrl);
-	if (ret)
-		return ret;
+	ret = 0;
+	if (soc_data->ngpios) {
+		ret = msm_gpio_init(pctrl);
+		if (ret)
+			return ret;
+	}
 
 	platform_set_drvdata(pdev, pctrl);
 
-	dev_dbg(&pdev->dev, "Probed Qualcomm pinctrl driver\n");
+	dev_info(&pdev->dev, "Probed Qualcomm pinctrl (irq=%d ngpios=%u)\n",
+		 pctrl->irq, soc_data->ngpios);
 
 	return 0;
 }
