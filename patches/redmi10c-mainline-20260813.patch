diff --git a/drivers/power/supply/sh366101_fg_bringup.c b/drivers/power/supply/sh366101_fg_bringup.c
new file mode 100644
index 000000000..5483095b4
--- /dev/null
+++ b/drivers/power/supply/sh366101_fg_bringup.c
@@ -0,0 +1,253 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2026 Damir00109 <internet00109@gmail.com>
+ * https://github.com/Damir00109/Redmi10c
+ */
+/*
+ * Minimal SinoWealth sh366101 fuel-gauge bringup for Xiaomi rain (SM6225).
+ * Registers power_supply "bms" with SOC/voltage/current/temp from SBS regs.
+ * No AFI/TS firmware load — assumes gauge already running (ABL/Android).
+ *
+ * Register map from downstream sh366101_fg.c.
+ */
+
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/power_supply.h>
+#include <linux/slab.h>
+#include <linux/workqueue.h>
+
+#define SH_REG_VOLTAGE		0x04
+#define SH_REG_CURRENT		0x10
+#define SH_REG_RMC		0x0C
+#define SH_REG_FCC		0x0E
+#define SH_REG_STATUS		0x06
+#define SH_REG_SOC		0x1C
+#define SH_REG_TEMP_EX		0x02
+#define SH_REG_CYCLE		0x1A
+
+#define FG_STATUS_BATT_PRESENT	BIT(3)
+
+#define POLL_MS			5000
+
+struct sh366101_bringup {
+	struct i2c_client	*client;
+	struct mutex		lock;
+	struct power_supply	*bms_psy;
+	struct delayed_work	poll_work;
+	int			soc;
+	int			volt_uv;
+	int			curr_ua;
+	int			temp_dC;
+	int			fcc_uah;
+	int			rmc_uah;
+	int			cycle;
+	bool			present;
+};
+
+static int sh_read_word(struct sh366101_bringup *fg, u8 reg, u16 *val)
+{
+	int rc = i2c_smbus_read_word_data(fg->client, reg);
+
+	if (rc < 0)
+		return rc;
+	*val = (u16)rc;
+	return 0;
+}
+
+static void sh_refresh(struct sh366101_bringup *fg)
+{
+	u16 data;
+	int soc_raw;
+
+	mutex_lock(&fg->lock);
+
+	if (!sh_read_word(fg, SH_REG_STATUS, &data))
+		fg->present = !!(data & FG_STATUS_BATT_PRESENT);
+	else
+		fg->present = true; /* keep optimistic if status fails */
+
+	if (!sh_read_word(fg, SH_REG_SOC, &data)) {
+		soc_raw = (int)data;
+		/* Chip reports 0..10000 (0.01%) on rain; also tolerate 0..100 */
+		if (soc_raw > 100)
+			fg->soc = DIV_ROUND_CLOSEST(soc_raw, 100);
+		else
+			fg->soc = soc_raw;
+		if (fg->soc < 0)
+			fg->soc = 0;
+		if (fg->soc > 100)
+			fg->soc = 100;
+	}
+
+	if (!sh_read_word(fg, SH_REG_VOLTAGE, &data))
+		fg->volt_uv = (int)data * 1000;
+
+	if (!sh_read_word(fg, SH_REG_CURRENT, &data))
+		fg->curr_ua = (int)((s16)data) * 1000;
+
+	if (!sh_read_word(fg, SH_REG_TEMP_EX, &data))
+		fg->temp_dC = (int)data - 2731;
+
+	if (!sh_read_word(fg, SH_REG_FCC, &data))
+		fg->fcc_uah = (int)data * 1000;
+
+	if (!sh_read_word(fg, SH_REG_RMC, &data))
+		fg->rmc_uah = (int)data * 1000;
+
+	if (!sh_read_word(fg, SH_REG_CYCLE, &data))
+		fg->cycle = (int)data;
+
+	mutex_unlock(&fg->lock);
+
+	dev_dbg(&fg->client->dev,
+		"sh366101: soc=%d%% v=%duV i=%duA t=%d rmc=%d fcc=%d present=%d\n",
+		fg->soc, fg->volt_uv, fg->curr_ua, fg->temp_dC,
+		fg->rmc_uah, fg->fcc_uah, fg->present);
+}
+
+static void sh_poll_work(struct work_struct *work)
+{
+	struct sh366101_bringup *fg = container_of(to_delayed_work(work),
+						   struct sh366101_bringup,
+						   poll_work);
+
+	sh_refresh(fg);
+	power_supply_changed(fg->bms_psy);
+	schedule_delayed_work(&fg->poll_work, msecs_to_jiffies(POLL_MS));
+}
+
+static int sh_bms_get_prop(struct power_supply *psy,
+			   enum power_supply_property psp,
+			   union power_supply_propval *val)
+{
+	struct sh366101_bringup *fg = power_supply_get_drvdata(psy);
+
+	mutex_lock(&fg->lock);
+	switch (psp) {
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = fg->present;
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		val->intval = fg->soc;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		val->intval = fg->volt_uv;
+		break;
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		val->intval = fg->curr_ua;
+		break;
+	case POWER_SUPPLY_PROP_TEMP:
+		val->intval = fg->temp_dC;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_FULL:
+		val->intval = fg->fcc_uah;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_NOW:
+		val->intval = fg->rmc_uah;
+		break;
+	case POWER_SUPPLY_PROP_CYCLE_COUNT:
+		val->intval = fg->cycle;
+		break;
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		break;
+	case POWER_SUPPLY_PROP_MODEL_NAME:
+		val->strval = "sh366101";
+		break;
+	default:
+		mutex_unlock(&fg->lock);
+		return -EINVAL;
+	}
+	mutex_unlock(&fg->lock);
+	return 0;
+}
+
+static enum power_supply_property sh_bms_props[] = {
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_TEMP,
+	POWER_SUPPLY_PROP_CHARGE_FULL,
+	POWER_SUPPLY_PROP_CHARGE_NOW,
+	POWER_SUPPLY_PROP_CYCLE_COUNT,
+	POWER_SUPPLY_PROP_TECHNOLOGY,
+	POWER_SUPPLY_PROP_MODEL_NAME,
+};
+
+static const struct power_supply_desc sh_bms_desc = {
+	.name		= "bms",
+	.type		= POWER_SUPPLY_TYPE_BATTERY,
+	.properties	= sh_bms_props,
+	.num_properties	= ARRAY_SIZE(sh_bms_props),
+	.get_property	= sh_bms_get_prop,
+};
+
+static int sh366101_bringup_probe(struct i2c_client *client)
+{
+	struct sh366101_bringup *fg;
+	struct power_supply_config psy_cfg = {};
+	u16 id;
+	int rc;
+
+	fg = devm_kzalloc(&client->dev, sizeof(*fg), GFP_KERNEL);
+	if (!fg)
+		return -ENOMEM;
+
+	fg->client = client;
+	mutex_init(&fg->lock);
+	i2c_set_clientdata(client, fg);
+
+	/* Probe: voltage register must respond */
+	rc = sh_read_word(fg, SH_REG_VOLTAGE, &id);
+	if (rc) {
+		dev_err(&client->dev, "sh366101 not responding (%d)\n", rc);
+		return rc;
+	}
+
+	fg->soc = 50;
+	fg->present = true;
+	sh_refresh(fg);
+
+	psy_cfg.drv_data = fg;
+	fg->bms_psy = devm_power_supply_register(&client->dev, &sh_bms_desc,
+						 &psy_cfg);
+	if (IS_ERR(fg->bms_psy))
+		return PTR_ERR(fg->bms_psy);
+
+	INIT_DELAYED_WORK(&fg->poll_work, sh_poll_work);
+	schedule_delayed_work(&fg->poll_work, msecs_to_jiffies(POLL_MS));
+
+	dev_info(&client->dev, "sh366101 FG bringup probed @0x%02x (soc=%d%%)\n",
+		 client->addr, fg->soc);
+	return 0;
+}
+
+static void sh366101_bringup_remove(struct i2c_client *client)
+{
+	struct sh366101_bringup *fg = i2c_get_clientdata(client);
+
+	cancel_delayed_work_sync(&fg->poll_work);
+}
+
+static const struct of_device_id sh366101_bringup_of_match[] = {
+	{ .compatible = "sh,sh366101-bringup" },
+	{ .compatible = "sh,sh366101" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sh366101_bringup_of_match);
+
+static struct i2c_driver sh366101_bringup_driver = {
+	.driver = {
+		.name = "sh366101-fg-bringup",
+		.of_match_table = sh366101_bringup_of_match,
+	},
+	.probe = sh366101_bringup_probe,
+	.remove = sh366101_bringup_remove,
+};
+module_i2c_driver(sh366101_bringup_driver);
+
+MODULE_DESCRIPTION("SinoWealth sh366101 fuel gauge bringup (minimal)");
+MODULE_LICENSE("GPL");
diff --git a/drivers/power/supply/smb1351_charger_bringup.c b/drivers/power/supply/smb1351_charger_bringup.c
new file mode 100644
index 000000000..9ddc8189c
--- /dev/null
+++ b/drivers/power/supply/smb1351_charger_bringup.c
@@ -0,0 +1,764 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2026 Damir00109 <internet00109@gmail.com>
+ * https://github.com/Damir00109/Redmi10c
+ */
+/*
+ * Minimal smb1351 USB charger bringup for Xiaomi rain (SM6225).
+ * Goal: enable charging from host USB VBUS without full downstream stack.
+ *
+ * Register map / enable sequence derived from CLO smb1351-charger.c.
+ */
+
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/power_supply.h>
+#include <linux/slab.h>
+#include <linux/workqueue.h>
+
+#define SMB1351_MASK(h, l)	GENMASK((h), (l))
+
+#define CHG_CURRENT_CTRL_REG		0x00
+#define FAST_CHG_CURRENT_MASK		SMB1351_MASK(7, 4)
+#define AC_INPUT_CURRENT_LIMIT_MASK	SMB1351_MASK(3, 0)
+
+#define CHG_OTH_CURRENT_CTRL_REG	0x01
+#define ITERM_MASK			SMB1351_MASK(4, 2)
+#define USB_2_3_MODE_SEL_BIT		BIT(1)
+#define USB_CMD_POLARITY_BIT		BIT(0)
+
+#define VARIOUS_FUNC_REG		0x02
+#define SUSPEND_MODE_CTRL_BIT		BIT(7)
+#define AICL_EN_BIT			BIT(4)
+#define APSD_EN_BIT			BIT(2)
+
+#define VFLOAT_REG			0x03
+#define VFLOAT_MASK			SMB1351_MASK(5, 0)
+
+#define CHG_CTRL_REG			0x04
+#define ITERM_EN_BIT			BIT(6)
+
+#define CHG_PIN_EN_CTRL_REG		0x06
+#define LED_BLINK_FUNC_BIT		BIT(7)
+#define EN_PIN_CTRL_MASK		SMB1351_MASK(6, 5)
+#define EN_BY_I2C_0_DISABLE		0x00
+#define EN_BY_I2C_0_ENABLE		0x20
+#define USBCS_CTRL_BIT			BIT(4)
+#define USBCS_CTRL_BY_I2C		0x00
+#define CHG_ERR_BIT			BIT(2)
+#define APSD_DONE_BIT			BIT(1)
+
+#define WDOG_SAFETY_TIMER_CTRL_REG	0x08
+#define WDOG_TIMER_EN_BIT		BIT(0)
+
+#define VARIOUS_FUNC_2_REG		0x0F
+#define FAST_CHG_CURRENT_SHIFT		4
+
+#define CMD_I2C_REG			0x30
+#define CMD_BQ_CFG_ACCESS_BIT		BIT(6)
+
+#define CMD_INPUT_LIMIT_REG		0x31
+#define CMD_SUSPEND_MODE_BIT		BIT(6)
+#define CMD_INPUT_CURRENT_MODE_BIT	BIT(3)
+#define CMD_USB_2_3_SEL_BIT		BIT(2)
+#define CMD_USB_1_5_AC_CTRL_MASK	SMB1351_MASK(1, 0)
+#define CMD_USB_500_MODE		0x2
+#define CMD_USB_AC_MODE			0x1
+
+#define CMD_CHG_REG			0x32
+#define CMD_CHG_EN_BIT			BIT(1)
+#define CMD_CHG_ENABLE			0x2
+
+#define CMD_HVDCP_REG			0x34
+#define CMD_APSD_RE_RUN_BIT		BIT(7)
+
+#define STATUS_1_REG			0x37
+#define STATUS_INPUT_USB_BIT		BIT(0)
+
+#define STATUS_2_REG			0x38
+#define STATUS_FAST_CHG_BIT		BIT(7)
+#define STATUS_FLOAT_VOLTAGE_MASK	SMB1351_MASK(5, 0)
+
+#define STATUS_3_REG			0x39
+#define STATUS_CHG_BIT			BIT(7)
+#define STATUS_FAST_CHG_CURRENT_MASK	SMB1351_MASK(3, 0)
+
+#define STATUS_4_REG			0x3A
+#define STATUS_DONE_BIT			BIT(5)
+#define STATUS_CHG_MASK			SMB1351_MASK(2, 1)
+#define STATUS_NO_CHARGING		0
+#define STATUS_PRE_CHARGING		(1 << 1)
+#define STATUS_FAST_CHARGING		(2 << 1)
+#define STATUS_TAPER_CHARGING		(3 << 1)
+
+#define STATUS_5_REG			0x3B
+#define STATUS_ADAPTER_BIT		BIT(3)
+
+#define CHG_ITERM_200MA			0x00
+
+#define MIN_FLOAT_MV			3500
+#define MAX_FLOAT_MV			4500
+#define VFLOAT_STEP_MV			20
+
+#define POLL_MS				2000
+
+struct smb1351_bringup {
+	struct i2c_client	*client;
+	struct mutex		lock;
+	struct power_supply	*batt_psy;
+	struct power_supply	*usb_psy;
+	struct power_supply	*bms_psy;
+	struct delayed_work	poll_work;
+	int			vfloat_mv;
+	int			iterm_ma;
+	int			icl_ua;
+	bool			online;
+	bool			charging;
+	bool			adapter;
+	/* SW Jeita (decidegc = 0.1 °C) */
+	int			jeita_cold_dC;
+	int			jeita_cool_dC;
+	int			jeita_warm_dC;
+	int			jeita_hot_dC;
+	int			jeita_cool_ma;
+	int			jeita_warm_ma;
+	int			jeita_cool_mv;
+	int			jeita_warm_mv;
+	int			jeita_fcc_ma;
+	int			jeita_float_mv;
+	bool			jeita_chg_disable;
+	const char		*jeita_zone;
+};
+
+static void smb1351_check_bms(struct smb1351_bringup *chip)
+{
+	if (!chip->bms_psy)
+		chip->bms_psy = power_supply_get_by_name("bms");
+}
+
+static int smb1351_from_bms(struct smb1351_bringup *chip,
+			    enum power_supply_property psp,
+			    union power_supply_propval *val)
+{
+	smb1351_check_bms(chip);
+	if (!chip->bms_psy)
+		return -ENODEV;
+	return power_supply_get_property(chip->bms_psy, psp, val);
+}
+
+static int smb1351_read(struct smb1351_bringup *chip, u8 reg, u8 *val)
+{
+	int rc = i2c_smbus_read_byte_data(chip->client, reg);
+
+	if (rc < 0)
+		return rc;
+	*val = rc;
+	return 0;
+}
+
+static int smb1351_write(struct smb1351_bringup *chip, u8 reg, u8 val)
+{
+	return i2c_smbus_write_byte_data(chip->client, reg, val);
+}
+
+static int smb1351_masked_write(struct smb1351_bringup *chip, u8 reg,
+				u8 mask, u8 val)
+{
+	u8 tmp;
+	int rc;
+
+	rc = smb1351_read(chip, reg, &tmp);
+	if (rc)
+		return rc;
+	tmp = (tmp & ~mask) | (val & mask);
+	return smb1351_write(chip, reg, tmp);
+}
+
+static int smb1351_enable_volatile(struct smb1351_bringup *chip)
+{
+	return smb1351_masked_write(chip, CMD_I2C_REG, CMD_BQ_CFG_ACCESS_BIT,
+				    CMD_BQ_CFG_ACCESS_BIT);
+}
+
+static int smb1351_set_float(struct smb1351_bringup *chip, int mv)
+{
+	u8 code;
+
+	if (mv < MIN_FLOAT_MV || mv > MAX_FLOAT_MV)
+		return -EINVAL;
+	code = (mv - MIN_FLOAT_MV) / VFLOAT_STEP_MV;
+	return smb1351_masked_write(chip, VFLOAT_REG, VFLOAT_MASK, code);
+}
+
+static int smb1351_set_fcc(struct smb1351_bringup *chip, int ma)
+{
+	/* fast_chg_current table index for 1000mA = 2 (see downstream) */
+	static const int fcc_ma[] = {
+		500, 685, 1000, 1100, 1200, 1300, 1500, 1600,
+		1700, 1800, 2000, 2200, 2500, 3000
+	};
+	int i;
+
+	for (i = ARRAY_SIZE(fcc_ma) - 1; i >= 0; i--) {
+		if (fcc_ma[i] <= ma)
+			break;
+	}
+	if (i < 0)
+		i = 0;
+
+	return smb1351_masked_write(chip, CHG_CURRENT_CTRL_REG,
+				    FAST_CHG_CURRENT_MASK,
+				    i << FAST_CHG_CURRENT_SHIFT);
+}
+
+static int smb1351_hw_init(struct smb1351_bringup *chip)
+{
+	int rc;
+	u8 reg;
+
+	rc = smb1351_enable_volatile(chip);
+	if (rc) {
+		dev_err(&chip->client->dev, "volatile enable failed %d\n", rc);
+		return rc;
+	}
+
+	/* Disable watchdog */
+	rc = smb1351_masked_write(chip, WDOG_SAFETY_TIMER_CTRL_REG,
+				  WDOG_TIMER_EN_BIT, 0);
+	if (rc)
+		return rc;
+
+	/*
+	 * Match CLO: EN_BY_I2C_0_DISABLE means charge enable via CMD_CHG_REG
+	 * (EN_BY_I2C_0_ENABLE inverts and leaves batt not charging).
+	 */
+	rc = smb1351_masked_write(chip, CHG_PIN_EN_CTRL_REG,
+				  EN_PIN_CTRL_MASK | USBCS_CTRL_BIT |
+				  CHG_ERR_BIT | APSD_DONE_BIT | LED_BLINK_FUNC_BIT,
+				  EN_BY_I2C_0_DISABLE | USBCS_CTRL_BY_I2C |
+				  CHG_ERR_BIT | APSD_DONE_BIT | LED_BLINK_FUNC_BIT);
+	if (rc)
+		return rc;
+
+	/* Suspend/AICL/APSD controlled by I2C; enable APSD + AICL */
+	rc = smb1351_masked_write(chip, VARIOUS_FUNC_REG,
+				  SUSPEND_MODE_CTRL_BIT | AICL_EN_BIT | APSD_EN_BIT,
+				  SUSPEND_MODE_CTRL_BIT | AICL_EN_BIT | APSD_EN_BIT);
+	if (rc)
+		return rc;
+
+	/* USB 2.0 / 500mA command polarity */
+	rc = smb1351_masked_write(chip, CHG_OTH_CURRENT_CTRL_REG,
+				  USB_2_3_MODE_SEL_BIT | USB_CMD_POLARITY_BIT, 0);
+	if (rc)
+		return rc;
+
+	rc = smb1351_set_float(chip, chip->vfloat_mv);
+	if (rc)
+		return rc;
+
+	/* FCC 1000mA — enough for SDP bringup without stressing cable */
+	rc = smb1351_set_fcc(chip, 1000);
+	if (rc)
+		return rc;
+
+	/* iterm 200mA + enable */
+	rc = smb1351_masked_write(chip, CHG_OTH_CURRENT_CTRL_REG, ITERM_MASK,
+				  CHG_ITERM_200MA);
+	if (rc)
+		return rc;
+	rc = smb1351_masked_write(chip, CHG_CTRL_REG, ITERM_EN_BIT, 0);
+	if (rc)
+		return rc;
+
+	/* Clear input suspend; USB 500mA command mode for gadget SDP */
+	rc = smb1351_masked_write(chip, CMD_INPUT_LIMIT_REG,
+				  CMD_SUSPEND_MODE_BIT | CMD_INPUT_CURRENT_MODE_BIT |
+				  CMD_USB_2_3_SEL_BIT | CMD_USB_1_5_AC_CTRL_MASK,
+				  CMD_INPUT_CURRENT_MODE_BIT | CMD_USB_500_MODE);
+	if (rc)
+		return rc;
+
+	/* Enable charging via CMD */
+	rc = smb1351_masked_write(chip, CMD_CHG_REG, CMD_CHG_EN_BIT,
+				  CMD_CHG_ENABLE);
+	if (rc)
+		return rc;
+
+	/* Kick APSD in case VBUS already present */
+	rc = smb1351_masked_write(chip, CMD_HVDCP_REG, CMD_APSD_RE_RUN_BIT,
+				  CMD_APSD_RE_RUN_BIT);
+	if (rc)
+		dev_warn(&chip->client->dev, "APSD re-run failed %d\n", rc);
+
+	msleep(50);
+
+	rc = smb1351_read(chip, STATUS_4_REG, &reg);
+	if (!rc)
+		dev_info(&chip->client->dev,
+			 "smb1351 bringup init ok (status4=0x%02x float=%dmV)\n",
+			 reg, chip->vfloat_mv);
+	return 0;
+}
+
+static void smb1351_apply_icl(struct smb1351_bringup *chip)
+{
+	u8 cmd;
+	int fcc;
+
+	smb1351_enable_volatile(chip);
+	if (chip->jeita_chg_disable) {
+		smb1351_masked_write(chip, CMD_CHG_REG, CMD_CHG_EN_BIT, 0);
+		chip->icl_ua = 0;
+		return;
+	}
+
+	if (chip->adapter) {
+		cmd = CMD_INPUT_CURRENT_MODE_BIT | CMD_USB_AC_MODE;
+		chip->icl_ua = 1500000;
+		fcc = 1500;
+	} else {
+		cmd = CMD_INPUT_CURRENT_MODE_BIT | CMD_USB_500_MODE;
+		chip->icl_ua = 500000;
+		fcc = 1000;
+	}
+	if (chip->jeita_fcc_ma > 0 && chip->jeita_fcc_ma < fcc)
+		fcc = chip->jeita_fcc_ma;
+
+	smb1351_set_fcc(chip, fcc);
+	if (chip->jeita_float_mv > 0)
+		smb1351_set_float(chip, chip->jeita_float_mv);
+	else
+		smb1351_set_float(chip, chip->vfloat_mv);
+
+	smb1351_masked_write(chip, CMD_INPUT_LIMIT_REG,
+			     CMD_SUSPEND_MODE_BIT | CMD_INPUT_CURRENT_MODE_BIT |
+			     CMD_USB_2_3_SEL_BIT | CMD_USB_1_5_AC_CTRL_MASK,
+			     cmd);
+	smb1351_masked_write(chip, CMD_CHG_REG, CMD_CHG_EN_BIT, CMD_CHG_ENABLE);
+}
+
+/*
+ * Software Jeita from BMS temp (Android rain thresholds).
+ * Zones: cold / cool / normal / warm / hot.
+ */
+static void smb1351_apply_jeita(struct smb1351_bringup *chip)
+{
+	union power_supply_propval val = {};
+	int temp_dC;
+	const char *zone;
+	int fcc = chip->adapter ? 1500 : 1000;
+	int fmv = chip->vfloat_mv;
+	bool disable = false;
+
+	if (smb1351_from_bms(chip, POWER_SUPPLY_PROP_TEMP, &val))
+		return;
+	temp_dC = val.intval;
+
+	if (temp_dC <= chip->jeita_cold_dC) {
+		zone = "cold";
+		disable = true;
+		fcc = 0;
+	} else if (temp_dC < chip->jeita_cool_dC) {
+		zone = "cool";
+		fcc = chip->jeita_cool_ma;
+		fmv = chip->jeita_cool_mv;
+	} else if (temp_dC < chip->jeita_warm_dC) {
+		zone = "normal";
+	} else if (temp_dC < chip->jeita_hot_dC) {
+		zone = "warm";
+		fcc = chip->jeita_warm_ma;
+		fmv = chip->jeita_warm_mv;
+	} else {
+		zone = "hot";
+		disable = true;
+		fcc = 0;
+	}
+
+	if (!chip->jeita_zone || strcmp(chip->jeita_zone, zone)) {
+		dev_dbg(&chip->client->dev,
+			 "jeita: zone=%s temp=%d fcc=%dmA float=%dmV %s\n",
+			 zone, temp_dC, fcc, fmv,
+			 disable ? "CHG_OFF" : "CHG_ON");
+		chip->jeita_zone = zone;
+	}
+	chip->jeita_fcc_ma = fcc;
+	chip->jeita_float_mv = fmv;
+	chip->jeita_chg_disable = disable;
+}
+
+static void smb1351_update_status(struct smb1351_bringup *chip)
+{
+	u8 s1 = 0, s3 = 0, s4 = 0, s5 = 0;
+	bool online, charging, adapter;
+
+	if (smb1351_read(chip, STATUS_1_REG, &s1) ||
+	    smb1351_read(chip, STATUS_3_REG, &s3) ||
+	    smb1351_read(chip, STATUS_4_REG, &s4) ||
+	    smb1351_read(chip, STATUS_5_REG, &s5))
+		return;
+
+	online = !!(s1 & STATUS_INPUT_USB_BIT) || !!(s5 & STATUS_ADAPTER_BIT);
+	adapter = !!(s5 & STATUS_ADAPTER_BIT);
+	charging = !!(s3 & STATUS_CHG_BIT) ||
+		   ((s4 & STATUS_CHG_MASK) != STATUS_NO_CHARGING);
+
+	if (adapter != chip->adapter) {
+		chip->adapter = adapter;
+		smb1351_apply_icl(chip);
+	}
+
+	if (online != chip->online || charging != chip->charging) {
+		dev_dbg(&chip->client->dev,
+			 "smb1351: online=%d charging=%d adapter=%d s1=%02x s3=%02x s4=%02x s5=%02x\n",
+			 online, charging, adapter, s1, s3, s4, s5);
+		chip->online = online;
+		chip->charging = charging;
+		power_supply_changed(chip->batt_psy);
+		power_supply_changed(chip->usb_psy);
+	} else {
+		chip->online = online;
+		chip->charging = charging;
+	}
+}
+
+static void smb1351_poll_work(struct work_struct *work)
+{
+	struct smb1351_bringup *chip = container_of(to_delayed_work(work),
+						    struct smb1351_bringup,
+						    poll_work);
+
+	/* Jeita reads BMS — must not hold chip->lock */
+	smb1351_apply_jeita(chip);
+
+	mutex_lock(&chip->lock);
+	smb1351_apply_icl(chip);
+	smb1351_update_status(chip);
+
+	/*
+	 * Cable replug makes charging=1: APSD often finishes only after VBUS
+	 * settles post-gadget enum. Re-kick APSD while online but not charging.
+	 */
+	if (chip->online && !chip->charging) {
+		smb1351_masked_write(chip, CMD_HVDCP_REG, CMD_APSD_RE_RUN_BIT,
+				     CMD_APSD_RE_RUN_BIT);
+		dev_dbg_ratelimited(&chip->client->dev,
+				    "smb1351: APSD re-kick (online, not charging)\n");
+	}
+	mutex_unlock(&chip->lock);
+
+	schedule_delayed_work(&chip->poll_work, msecs_to_jiffies(POLL_MS));
+}
+
+static int smb1351_batt_get_prop(struct power_supply *psy,
+				 enum power_supply_property psp,
+				 union power_supply_propval *val)
+{
+	struct smb1351_bringup *chip = power_supply_get_drvdata(psy);
+	u8 s2 = 0, s4 = 0;
+	int chg;
+	bool online, charging, adapter;
+	int vfloat_mv;
+
+	/* BMS props: no chip lock (bms has its own) */
+	switch (psp) {
+	case POWER_SUPPLY_PROP_CAPACITY:
+		if (smb1351_from_bms(chip, psp, val))
+			val->intval = 50;
+		return 0;
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		if (smb1351_from_bms(chip, psp, val))
+			val->intval = 0;
+		return 0;
+	case POWER_SUPPLY_PROP_TEMP:
+		if (smb1351_from_bms(chip, psp, val))
+			val->intval = 250;
+		return 0;
+	case POWER_SUPPLY_PROP_CHARGE_FULL:
+	case POWER_SUPPLY_PROP_CHARGE_NOW:
+	case POWER_SUPPLY_PROP_CYCLE_COUNT:
+		return smb1351_from_bms(chip, psp, val) ? -ENODATA : 0;
+	case POWER_SUPPLY_PROP_PRESENT:
+		if (!smb1351_from_bms(chip, psp, val))
+			return 0;
+		val->intval = 1;
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		if (!smb1351_from_bms(chip, psp, val))
+			return 0;
+		break; /* fall through to charger float fallback */
+	default:
+		break;
+	}
+
+	mutex_lock(&chip->lock);
+	online = chip->online;
+	charging = chip->charging;
+	adapter = chip->adapter;
+	vfloat_mv = chip->vfloat_mv;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_STATUS:
+		if (!online) {
+			val->intval = POWER_SUPPLY_STATUS_DISCHARGING;
+		} else if (charging) {
+			val->intval = POWER_SUPPLY_STATUS_CHARGING;
+		} else if (!smb1351_read(chip, STATUS_4_REG, &s4) &&
+			   (s4 & STATUS_DONE_BIT)) {
+			val->intval = POWER_SUPPLY_STATUS_FULL;
+		} else {
+			val->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		}
+		break;
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		if (!smb1351_read(chip, STATUS_2_REG, &s2))
+			val->intval = (MIN_FLOAT_MV +
+				(s2 & STATUS_FLOAT_VOLTAGE_MASK) * VFLOAT_STEP_MV)
+				* 1000;
+		else
+			val->intval = vfloat_mv * 1000;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_MAX:
+		val->intval = vfloat_mv * 1000;
+		break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX:
+		val->intval = adapter ? 1500000 : 1000000;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_TYPE:
+		if (!smb1351_read(chip, STATUS_4_REG, &s4)) {
+			chg = s4 & STATUS_CHG_MASK;
+			if (chg == STATUS_FAST_CHARGING)
+				val->intval = POWER_SUPPLY_CHARGE_TYPE_FAST;
+			else if (chg == STATUS_PRE_CHARGING ||
+				 chg == STATUS_TAPER_CHARGING)
+				val->intval = POWER_SUPPLY_CHARGE_TYPE_TRICKLE;
+			else
+				val->intval = POWER_SUPPLY_CHARGE_TYPE_NONE;
+		} else {
+			val->intval = POWER_SUPPLY_CHARGE_TYPE_NONE;
+		}
+		break;
+	case POWER_SUPPLY_PROP_HEALTH:
+		if (chip->jeita_chg_disable && chip->jeita_zone) {
+			if (!strcmp(chip->jeita_zone, "cold"))
+				val->intval = POWER_SUPPLY_HEALTH_COLD;
+			else if (!strcmp(chip->jeita_zone, "hot"))
+				val->intval = POWER_SUPPLY_HEALTH_OVERHEAT;
+			else
+				val->intval = POWER_SUPPLY_HEALTH_GOOD;
+		} else if (chip->jeita_zone && !strcmp(chip->jeita_zone, "warm")) {
+			val->intval = POWER_SUPPLY_HEALTH_WARM;
+		} else if (chip->jeita_zone && !strcmp(chip->jeita_zone, "cool")) {
+			val->intval = POWER_SUPPLY_HEALTH_COOL;
+		} else {
+			val->intval = POWER_SUPPLY_HEALTH_GOOD;
+		}
+		break;
+	case POWER_SUPPLY_PROP_MODEL_NAME:
+		val->strval = "smb1351";
+		break;
+	default:
+		mutex_unlock(&chip->lock);
+		return -EINVAL;
+	}
+	mutex_unlock(&chip->lock);
+	return 0;
+}
+
+static int smb1351_usb_get_prop(struct power_supply *psy,
+				enum power_supply_property psp,
+				union power_supply_propval *val)
+{
+	struct smb1351_bringup *chip = power_supply_get_drvdata(psy);
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_ONLINE:
+		val->intval = chip->online;
+		break;
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = chip->online;
+		break;
+	case POWER_SUPPLY_PROP_CURRENT_MAX:
+		val->intval = chip->icl_ua;
+		break;
+	case POWER_SUPPLY_PROP_USB_TYPE:
+		val->intval = chip->adapter ? POWER_SUPPLY_USB_TYPE_DCP
+					   : POWER_SUPPLY_USB_TYPE_SDP;
+		break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static enum power_supply_property smb1351_batt_props[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_TECHNOLOGY,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_TEMP,
+	POWER_SUPPLY_PROP_CHARGE_FULL,
+	POWER_SUPPLY_PROP_CHARGE_NOW,
+	POWER_SUPPLY_PROP_CYCLE_COUNT,
+	POWER_SUPPLY_PROP_VOLTAGE_MAX,
+	POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX,
+	POWER_SUPPLY_PROP_CHARGE_TYPE,
+	POWER_SUPPLY_PROP_HEALTH,
+	POWER_SUPPLY_PROP_MODEL_NAME,
+};
+
+static enum power_supply_property smb1351_usb_props[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_CURRENT_MAX,
+	POWER_SUPPLY_PROP_USB_TYPE,
+};
+
+static const struct power_supply_desc smb1351_batt_desc = {
+	.name		= "battery",
+	.type		= POWER_SUPPLY_TYPE_BATTERY,
+	.properties	= smb1351_batt_props,
+	.num_properties	= ARRAY_SIZE(smb1351_batt_props),
+	.get_property	= smb1351_batt_get_prop,
+};
+
+static const struct power_supply_desc smb1351_usb_desc = {
+	.name			= "usb",
+	.type			= POWER_SUPPLY_TYPE_USB,
+	.properties		= smb1351_usb_props,
+	.num_properties		= ARRAY_SIZE(smb1351_usb_props),
+	.get_property		= smb1351_usb_get_prop,
+	.usb_types		= BIT(POWER_SUPPLY_USB_TYPE_SDP) |
+				  BIT(POWER_SUPPLY_USB_TYPE_DCP) |
+				  BIT(POWER_SUPPLY_USB_TYPE_UNKNOWN),
+};
+
+static int smb1351_bringup_probe(struct i2c_client *client)
+{
+	struct smb1351_bringup *chip;
+	struct power_supply_config psy_cfg = {};
+	u8 id = 0;
+	int rc;
+
+	chip = devm_kzalloc(&client->dev, sizeof(*chip), GFP_KERNEL);
+	if (!chip)
+		return -ENOMEM;
+
+	chip->client = client;
+	mutex_init(&chip->lock);
+	i2c_set_clientdata(client, chip);
+
+	{
+		u32 tmp;
+
+		chip->vfloat_mv = 4460;
+		chip->iterm_ma = 200;
+		chip->icl_ua = 500000;
+		chip->jeita_cold_dC = 0;
+		chip->jeita_cool_dC = 50;
+		chip->jeita_warm_dC = 500;
+		chip->jeita_hot_dC = 550;
+		chip->jeita_cool_ma = 350;
+		chip->jeita_warm_ma = 350;
+		chip->jeita_cool_mv = 4200;
+		chip->jeita_warm_mv = 4200;
+		if (!of_property_read_u32(client->dev.of_node,
+					 "qcom,float-voltage-mv", &tmp))
+			chip->vfloat_mv = tmp;
+		if (!of_property_read_u32(client->dev.of_node,
+					 "qcom,iterm-ma", &tmp))
+			chip->iterm_ma = tmp;
+		if (!of_property_read_u32(client->dev.of_node,
+					 "qcom,batt-cold-decidegc", &tmp))
+			chip->jeita_cold_dC = (int)tmp;
+		if (!of_property_read_u32(client->dev.of_node,
+					 "qcom,batt-cool-decidegc", &tmp))
+			chip->jeita_cool_dC = (int)tmp;
+		if (!of_property_read_u32(client->dev.of_node,
+					 "qcom,batt-warm-decidegc", &tmp))
+			chip->jeita_warm_dC = (int)tmp;
+		if (!of_property_read_u32(client->dev.of_node,
+					 "qcom,batt-hot-decidegc", &tmp))
+			chip->jeita_hot_dC = (int)tmp;
+		if (!of_property_read_u32(client->dev.of_node,
+					 "qcom,batt-cool-ma", &tmp))
+			chip->jeita_cool_ma = (int)tmp;
+		if (!of_property_read_u32(client->dev.of_node,
+					 "qcom,batt-warm-ma", &tmp))
+			chip->jeita_warm_ma = (int)tmp;
+		if (!of_property_read_u32(client->dev.of_node,
+					 "qcom,batt-cool-mv", &tmp))
+			chip->jeita_cool_mv = (int)tmp;
+		if (!of_property_read_u32(client->dev.of_node,
+					 "qcom,batt-warm-mv", &tmp))
+			chip->jeita_warm_mv = (int)tmp;
+	}
+
+	rc = smb1351_read(chip, STATUS_4_REG, &id);
+	if (rc) {
+		dev_err(&client->dev, "smb1351 not responding on I2C (%d)\n", rc);
+		return rc;
+	}
+
+	rc = smb1351_hw_init(chip);
+	if (rc)
+		return rc;
+
+	psy_cfg.drv_data = chip;
+	psy_cfg.fwnode = dev_fwnode(&client->dev);
+
+	chip->batt_psy = devm_power_supply_register(&client->dev,
+						    &smb1351_batt_desc,
+						    &psy_cfg);
+	if (IS_ERR(chip->batt_psy))
+		return PTR_ERR(chip->batt_psy);
+
+	chip->usb_psy = devm_power_supply_register(&client->dev,
+						   &smb1351_usb_desc,
+						   &psy_cfg);
+	if (IS_ERR(chip->usb_psy))
+		return PTR_ERR(chip->usb_psy);
+
+	INIT_DELAYED_WORK(&chip->poll_work, smb1351_poll_work);
+	smb1351_update_status(chip);
+	/* First polls after gadget USB settles — matches cable-replug behavior */
+	schedule_delayed_work(&chip->poll_work, msecs_to_jiffies(3000));
+
+	dev_info(&client->dev, "smb1351 bringup probed @0x%02x\n", client->addr);
+	return 0;
+}
+
+static void smb1351_bringup_remove(struct i2c_client *client)
+{
+	struct smb1351_bringup *chip = i2c_get_clientdata(client);
+
+	cancel_delayed_work_sync(&chip->poll_work);
+	if (chip->bms_psy)
+		power_supply_put(chip->bms_psy);
+}
+
+static const struct of_device_id smb1351_bringup_of_match[] = {
+	{ .compatible = "qcom,smb1351-charger-bringup" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, smb1351_bringup_of_match);
+
+static struct i2c_driver smb1351_bringup_driver = {
+	.driver = {
+		.name = "smb1351-charger-bringup",
+		.of_match_table = smb1351_bringup_of_match,
+	},
+	.probe = smb1351_bringup_probe,
+	.remove = smb1351_bringup_remove,
+};
+module_i2c_driver(smb1351_bringup_driver);
+
+MODULE_DESCRIPTION("Qualcomm smb1351 charger bringup (minimal)");
+MODULE_LICENSE("GPL");
