index 000000000..6b0cdb578
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm6225-xiaomi-fog.dts
@@ -0,0 +1,564 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2026 Damir00109 <internet00109@gmail.com>
+ * https://github.com/Damir00109/Redmi10c
+ */
+/* Thin fog/rain + SPMI/pm6125 + RPM regulators (no GCC yet). */
+/dts-v1/;
+#include "sm6225.dtsi"
+#include "pm6125.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/clock/qcom,rpmcc.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+/ {
+	qcom,msm-id = <0x206 0x10000>;
+	qcom,board-id = <0x60022 0x00>;
+	model = "Xiaomi Redmi 10C fog/rain";
+	compatible = "xiaomi,fog", "qcom,sm6225";
+	chassis-type = "handset";
+
+	/* Bringup: exercise TLMM summary IRQ + gpio93 (Type-C INT) */
+	gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&vol_up_default>;
+
+		vol_up {
+			label = "volume_up";
+			gpios = <&pm6125_gpios 5 GPIO_ACTIVE_LOW>;
+			linux,input-type = <EV_KEY>;
+			linux,code = <KEY_VOLUMEUP>;
+			debounce-interval = <10>;
+		};
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		/* Panel is 720x1650 (Android 0x2d0 x 0x672); ABL leaves FB here. */
+		stdout-path = "framebuffer0";
+		bootargs = "console=tty0 consoleblank=0 earlycon clk_ignore_unused pd_ignore_unused";
+		framebuffer0: framebuffer@5c000000 {
+			compatible = "simple-framebuffer";
+			reg = <0 0x5c000000 0 (1650 * 720 * 4)>;
+			width = <720>;
+			height = <1650>;
+			stride = <(720 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		framebuffer-region@5c000000 {
+			reg = <0 0x5c000000 0 0x1000000>;
+			no-map;
+		};
+	};
+};
+
+&usb_dwc3 {
+	status = "okay";
+	dr_mode = "peripheral";
+	maximum-speed = "high-speed";
+};
+
+&pon_pwrkey {
+	status = "okay";
+};
+
+&pon_resin {
+	linux,code = <KEY_VOLUMEDOWN>;
+	status = "okay";
+};
+
+/* Full pm6125 peripherals (were disabled while drivers were =m / no modules). */
+&pm6125_adc {
+	status = "okay";
+};
+
+&pm6125_temp {
+	status = "okay";
+};
+
+&pm6125_rtc {
+	status = "okay";
+};
+
+&pm6125_gpios {
+	status = "okay";
+
+	vol_up_default: vol-up-default-state {
+		pins = "gpio5";
+		function = "normal";
+		input-enable;
+		bias-pull-up;
+	};
+
+	/*
+	 * Android disp_lcd_bias_en = PMIC gpio9 (func1 / vin0 / out).
+	 * SPMI MODE_CTL/EN_CTL writes return -EPERM here — do not claim.
+	 */
+};
+
+/*
+ * LCM ENP (gpio98) / ENN (gpio101) pinctrl states live in sm6225.dtsi
+ * (lcm_enp_default / lcm_enn_default). Do NOT apply at boot: SOUTH TLMM
+ * MMIO can hang the SoC (same class as reserved_gpios get_direction).
+ * ABL splash usually leaves panel bias already enabled.
+ */
+
+/*
+ * RPM regulators — UFS rails keep proven fixed µV; other LDOs expose Android
+ * ranges so consumers (display/audio/…) can vote later without always-on.
+ */
+&rpm_requests {
+	regulators-0 {
+		compatible = "qcom,rpm-pm6125-regulators";
+
+		pm6125_s6a: s6 {
+			regulator-min-microvolt = <320000>;
+			regulator-max-microvolt = <1456000>;
+		};
+
+		pm6125_s7a: s7 {
+			regulator-min-microvolt = <1280000>;
+			regulator-max-microvolt = <2040000>;
+		};
+
+		pm6125_s8a: s8 {
+			regulator-min-microvolt = <1064000>;
+			regulator-max-microvolt = <1304000>;
+		};
+
+		pm6125_l1a: l1 {
+			regulator-min-microvolt = <952000>;
+			regulator-max-microvolt = <1152000>;
+		};
+
+		pm6125_l2a: l2 {
+			regulator-min-microvolt = <488000>;
+			regulator-max-microvolt = <1000000>;
+		};
+
+		pm6125_l3a: l3 {
+			regulator-min-microvolt = <488000>;
+			regulator-max-microvolt = <1000000>;
+		};
+
+		/* UFS PHY — live Lineage 0.88 V */
+		pm6125_l4a: l4 {
+			regulator-min-microvolt = <880000>;
+			regulator-max-microvolt = <880000>;
+		};
+
+		pm6125_l5a: l5 {
+			regulator-min-microvolt = <1648000>;
+			regulator-max-microvolt = <3304000>;
+			regulator-allow-set-load;
+		};
+
+		pm6125_l6a: l6 {
+			regulator-min-microvolt = <576000>;
+			regulator-max-microvolt = <656000>;
+		};
+
+		pm6125_l7a: l7 {
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1304000>;
+		};
+
+		pm6125_l8a: l8 {
+			regulator-min-microvolt = <400000>;
+			regulator-max-microvolt = <728000>;
+		};
+
+		pm6125_l9a: l9 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <2000000>;
+			regulator-always-on;
+		};
+
+		pm6125_l10a: l10 {
+			regulator-min-microvolt = <1704000>;
+			regulator-max-microvolt = <1904000>;
+		};
+
+		/* UFS VCCQ2 — 1.8 V */
+		pm6125_l11a: l11 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-allow-set-load;
+		};
+
+		pm6125_l12a: l12 {
+			regulator-min-microvolt = <1624000>;
+			regulator-max-microvolt = <1984000>;
+		};
+
+		pm6125_l13a: l13 {
+			regulator-min-microvolt = <1504000>;
+			regulator-max-microvolt = <1952000>;
+		};
+
+		pm6125_l14a: l14 {
+			regulator-min-microvolt = <1704000>;
+			regulator-max-microvolt = <1904000>;
+		};
+
+		pm6125_l15a: l15 {
+			regulator-min-microvolt = <2920000>;
+			regulator-max-microvolt = <3232000>;
+		};
+
+		pm6125_l16a: l16 {
+			regulator-min-microvolt = <1704000>;
+			regulator-max-microvolt = <1904000>;
+		};
+
+		pm6125_l17a: l17 {
+			regulator-min-microvolt = <1152000>;
+			regulator-max-microvolt = <1304000>;
+		};
+
+		/* UFS VDDP-REF / PHY PLL — 1.232 V */
+		pm6125_l18a: l18 {
+			regulator-min-microvolt = <1232000>;
+			regulator-max-microvolt = <1232000>;
+		};
+
+		pm6125_l19a: l19 {
+			regulator-min-microvolt = <1624000>;
+			regulator-max-microvolt = <3304000>;
+		};
+
+		pm6125_l20a: l20 {
+			regulator-min-microvolt = <1624000>;
+			regulator-max-microvolt = <3304000>;
+		};
+
+		pm6125_l21a: l21 {
+			regulator-min-microvolt = <2400000>;
+			regulator-max-microvolt = <3544000>;
+		};
+
+		pm6125_l22a: l22 {
+			regulator-min-microvolt = <2952000>;
+			regulator-max-microvolt = <3304000>;
+			regulator-allow-set-load;
+		};
+
+		pm6125_l23a: l23 {
+			regulator-min-microvolt = <3296000>;
+			regulator-max-microvolt = <3304000>;
+			regulator-always-on;
+		};
+
+		/* UFS VCC — 2.95–2.96 V */
+		pm6125_l24a: l24 {
+			regulator-min-microvolt = <2950000>;
+			regulator-max-microvolt = <2960000>;
+			regulator-allow-set-load;
+		};
+	};
+};
+
+/*
+ * UFS from Android vendor_boot+dtbo59 (notes/dt-adapt/from-images/).
+ * Device: WDC SDINDDK4-64G UFS 2.2. Host PHY: qmp-v4 (SoC IP, not UFS 4/5).
+ * vdd-hba = GDSC via power-domains. Reset = pinctrl ufs_reset (ACTIVE_LOW);
+ * TLMM stub crashed — reset-gpios deferred.
+ */
+&ufs_mem_hc {
+	vcc-supply = <&pm6125_l24a>;
+	vcc-max-microamp = <800000>;
+	vccq2-supply = <&pm6125_l11a>;
+	vccq2-max-microamp = <800000>;
+	/* Android: qcom,vddp-ref-clk-supply = L18 @ 1.232V */
+	qcom,vddp-ref-clk-supply = <&pm6125_l18a>;
+	qcom,vddp-ref-clk-min-uV = <1232000>;
+	qcom,vddp-ref-clk-max-uV = <1232000>;
+	qcom,vddp-ref-clk-max-microamp = <100>;
+	qcom,force-legacy-dme-quirks;
+	qcom,disable-devfreq;
+	/*
+	 * UFS_RESET without TLMM driver: phys = west@0x500000 + 0x78000
+	 * = khaje flat 0x400000 + 0x178000. Active-low via MMIO out bit0.
+	 */
+	qcom,device-reset-mmio = <0x578000>;
+	status = "okay";
+};
+
+&ufs_mem_phy {
+	vdda-phy-supply = <&pm6125_l4a>;
+	vdda-phy-max-microamp = <85700>;
+	vdda-pll-supply = <&pm6125_l18a>;
+	vdda-pll-max-microamp = <18300>;
+	status = "okay";
+};
+
+/*
+ * External µSD — Android sdhc2 @4784000.
+ * CD is TLMM gpio88 (EAST, currently reserved — get_direction hang risk).
+ * Use broken-cd while card is inserted; enable cd-gpios after unreserving 88.
+ */
+&sdhc_2 {
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&sdc2_state_on>;
+	pinctrl-1 = <&sdc2_state_off>;
+
+	vmmc-supply = <&pm6125_l22a>;
+	vqmmc-supply = <&pm6125_l5a>;
+
+	bus-width = <4>;
+	broken-cd;
+	cap-sd-highspeed;
+	sd-uhs-sdr12;
+	sd-uhs-sdr25;
+	sd-uhs-sdr50;
+	sd-uhs-ddr50;
+	sd-uhs-sdr104;
+	max-frequency = <202000000>;
+
+	status = "okay";
+};
+
+&tlmm {
+	/* Android fog uses TLMM gpio106 for lcmblen; extend range */
+	gpio-ranges = <&tlmm 0 0 110>;
+
+	wusb3801_int_default: wusb3801-int-default-state {
+		pins = "gpio93";
+		function = "gpio";
+		input-enable;
+		bias-pull-up;
+	};
+
+	/* lcmblen — backlight boost HWEN on gpio106 (Android pmx_lcmblen) */
+	lcmblen_default: lcmblen-default-state {
+		pins = "gpio106";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+		output-high;
+	};
+
+	/* lcm1p8en — panel 1.8V discrete LDO enable on gpio103
+	 * (Android pmx_lcm1p8en; vendor vddio is a dummy regulator) */
+	lcm1p8en_default: lcm1p8en-default-state {
+		pins = "gpio103";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+		output-high;
+	};
+
+	/* TE from panel to MDP vsync on gpio81 */
+	sde_te_default: sde-te-default-state {
+		pins = "gpio81";
+		function = "mdp_vsync";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+};
+
+/*
+ * Vibrator — Android vibrator_gpio / qcom,qpnp-vibrator-ldo:
+ * enable on TLMM gpio36 (ACTIVE_HIGH). No separate VCC rail in vendor DT.
+ * Do not also list gpio36 in pinctrl-0 — gpiod claims the pin alone.
+ */
+/ {
+	vibrator {
+		compatible = "gpio-vibrator";
+		enable-gpios = <&tlmm 36 GPIO_ACTIVE_HIGH>;
+	};
+};
+
+/*
+ * Touch: GENI SE0 SPI has FIFO fused off; GPI DMA hangs this platform.
+ * Use spi-gpio bitbang on the same pins (idle levels: CLK low, CS high →
+ * gpio2=SCK, gpio3=CS, gpio0=MOSI, gpio1=MISO).
+ */
+&qupv3_id_0 {
+	status = "okay";
+};
+
+&gpi_dma0 {
+	status = "disabled";
+};
+
+&spi0 {
+	status = "disabled";
+};
+
+/ {
+	spi_gpio_ts: spi {
+		compatible = "spi-gpio";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/* QUP lane map: L0=MISO L1=MOSI L2=SCLK L3=CS */
+		sck-gpios = <&tlmm 2 GPIO_ACTIVE_HIGH>;
+		mosi-gpios = <&tlmm 1 GPIO_ACTIVE_HIGH>;
+		miso-gpios = <&tlmm 0 GPIO_ACTIVE_HIGH>;
+		cs-gpios = <&tlmm 3 GPIO_ACTIVE_LOW>;
+		num-chipselects = <1>;
+
+		touch@0 {
+			compatible = "focaltech,fts";
+			reg = <0>;
+			/* bitbang — keep modest */
+			spi-max-frequency = <1000000>;
+
+			interrupt-parent = <&tlmm>;
+			interrupts = <80 IRQ_TYPE_EDGE_FALLING>;
+			/* pull-up on IRQ only — reset via gpiod alone */
+			pinctrl-names = "default";
+			pinctrl-0 = <&ts_int_default>;
+
+			reset-gpios = <&tlmm 86 GPIO_ACTIVE_HIGH>;
+			/* irq via interrupts= + pinctrl pull-up; skip irq-gpios
+			 * (double-claim with pinctrl). Driver uses spi->irq. */
+
+			focaltech,max-touch-number = <10>;
+			focaltech,display-coords = <0 0 719 1649>;
+		};
+	};
+};
+
+&i2c1 {
+	status = "okay";
+	clock-frequency = <400000>;
+
+	sh366101@55 {
+		compatible = "sh,sh366101";
+		reg = <0x55>;
+	};
+
+	/*
+	 * No backlight/bias I2C devices here: chips at 0x36 (bkl-bl) and
+	 * 0x3e (lcm-bias) never ACK on the bus even in stock Android
+	 * (verified with i2cget/i2ctransfer as root, screen on). Android's
+	 * "lcm-bias" driver is a GPIO-only stub. Backlight boost only needs
+	 * HWEN (gpio106) high; brightness goes via DSI DCS 0x51 to FT8006S.
+	 */
+};
+
+&i2c2 {
+	status = "okay";
+	clock-frequency = <400000>;
+
+	smb1351@55 {
+		compatible = "qcom,smb1351-charger-bringup";
+		reg = <0x55>;
+	};
+
+	wusb3801@60 {
+		compatible = "willsemi,wusb3801";
+		reg = <0x60>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <93 IRQ_TYPE_LEVEL_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&wusb3801_int_default>;
+
+		connector {
+			compatible = "usb-c-connector";
+			label = "USB-C";
+			power-role = "dual";
+			try-power-role = "sink";
+			data-role = "dual";
+			typec-power-opmode = "default";
+			pd-disable;
+		};
+	};
+};
+
+/*
+ * GPU-first + Wi-Fi bringup: Adreno + ath10k_snoc (WCN3990).
+ * MDSS/DSI/panel stay off — ABL/simplefb only for display.
+ */
+&gpu_zap_shader {
+	firmware-name = "qcom/sm6225/a610_zap.mdt";
+};
+
+&gpu {
+	status = "okay";
+};
+
+/*
+ * DRM/DSI display re-attempt (2026-08-13, careful/incremental):
+ * a previous attempt hacked around apparent SMMU/video-done issues in
+ * dsi_host.c/dpu_kms.c/msm_fbdev.c and hung on boot; those C-level hacks
+ * are NOT reintroduced here. Only the DT nodes + panel driver come back,
+ * so if this still hangs we get a clean, diagnosable failure (console is
+ * now working, see AGENTS.md) instead of a silent brick.
+ */
+&dispcc {
+	status = "okay";
+};
+
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	vdda-supply = <&pm6125_l18a>;
+	status = "okay";
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&sde_te_default &lcm1p8en_default &lcmblen_default>;
+
+	panel: panel@0 {
+		compatible = "xinli,ft8006s";
+		reg = <0>;
+
+		/* Android uses ACTIVE_HIGH; reset-sequence is 1/0/1 */
+		reset-gpios = <&tlmm 82 GPIO_ACTIVE_HIGH>;
+		/* Android panel_active bias: ENP=gpio98, ENN=gpio101 (SOUTH,
+		 * deliberately unreserved in pinctrl-khaje.c for this panel) */
+		enp-gpios = <&tlmm 98 GPIO_ACTIVE_HIGH>;
+		enn-gpios = <&tlmm 101 GPIO_ACTIVE_HIGH>;
+		vddio-supply = <&pm6125_l9a>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	data-lanes = <0 1 2 3>;
+	remote-endpoint = <&panel_in>;
+};
+
+&mdss_dsi0_phy {
+	status = "okay";
+};
+
+/*
+ * Modem PAS + WCN3990 via mainline ath10k_snoc (not Android icnss/qcacld).
+ * Same rails as Motregen / Fxtec WCN3990.
+ */
+&remoteproc_mpss {
+	firmware-name = "qcom/sm6225/modem.mdt";
+	status = "okay";
+};
+
+&wifi {
+	vdd-0.8-cx-mx-supply = <&pm6125_l8a>;
+	vdd-1.8-xo-supply = <&pm6125_l16a>;
+	vdd-1.3-rfa-supply = <&pm6125_l17a>;
+	vdd-3.3-ch0-supply = <&pm6125_l23a>;
+	/* OEM WLAN MAC from Android (ath10k otherwise randomizes) */
+	local-mac-address = [f0 6c 5d 02 36 a2];
+	status = "okay";
+};
+
+/* Exclusive with &wifi — same MMIO @ 0xc800000 */
diff --git a/arch/arm64/boot/dts/qcom/sm6225-xiaomi-rain.dts b/arch/arm64/boot/dts/qcom/sm6225-xiaomi-rain.dts
new file mode 100644
index 000000000..722422ee8
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm6225-xiaomi-rain.dts
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2022, Lux Aliaga <they@mint.lgbt>
+ * Copyright (c) 2026 Damir00109 <internet00109@gmail.com>
+ * https://github.com/Damir00109/Redmi10c
+ */
+
+/dts-v1/;
+
+#include "sm6225.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/input/gpio-keys.h>
+
+/ {
+	/* required for bootloader to select correct board */
+	qcom,msm-id = <0x206 0x10000>;
+	qcom,board-id = <0x60022 0x00>;
+
+	model = "Xiaomi Redmi 10C";
+	compatible = "xiaomi,fog", "qcom,sm6225";
+	chassis-type = "handset";
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		framebuffer0: framebuffer@5c000000 {
+			compatible = "simple-framebuffer";
+			reg = <0 0x5c000000 0 (1650 * 720 * 4)>;
+			width = <720>;
+			height = <1650>;
+			stride = <(720 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+			debug_mem: memory@ffb00000 {
+			reg = <0x0 0xffb00000 0x0 0xc0000>;
+			no-map;
+		};
+
+		last_log_mem: memory@ffbc0000 {
+			reg = <0x0 0xffbc0000 0x0 0x80000>;
+			no-map;
+		};
+
+		pstore_mem: ramoops@ffc00000 {
+			compatible = "ramoops";
+			reg = <0x0 0xffc40000 0x0 0xc0000>;
+			record-size = <0x1000>;
+			console-size = <0x40000>;
+			msg-size = <0x20000 0x20000>;
+		};
+
+		cmdline_mem: memory@ffd00000 {
+			reg = <0x0 0xffd40000 0x0 0x1000>;
+			no-map;
+		};
+
+		framebuffer-region@5c000000 {
+			reg = <0 0x5c000000 0 0x1000000>;
+			no-map;
+		};
+
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm6225.dtsi b/arch/arm64/boot/dts/qcom/sm6225.dtsi
new file mode 100644
index 000000000..d7ffe1b2d
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm6225.dtsi
@@ -0,0 +1,1482 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2021, Martin Botka <martin.botka@somainline.org>
+ * Copyright (c) 2026 Damir00109 <internet00109@gmail.com>
+ * https://github.com/Damir00109/Redmi10c
+ */
+
+#include <dt-bindings/firmware/qcom,scm.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/power/qcom-rpmpd.h>
+#include <dt-bindings/clock/qcom,rpmcc.h>
+#include <dt-bindings/clock/qcom,gcc-sm6115.h>
+#include <dt-bindings/clock/qcom,sm6115-gpucc.h>
+#include <dt-bindings/clock/qcom,sm6375-dispcc.h>
+#include <dt-bindings/clock/qcom,dsi-phy-28nm.h>
+#include <dt-bindings/dma/qcom-gpi.h>
+
+/ {
+	interrupt-parent = <&intc>;
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	chosen { };
+
+	clocks {
+		xo_board: xo-board {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <19200000>;
+			clock-output-names = "xo_board";
+		};
+
+		sleep_clk: sleep-clk {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <32764>;
+			clock-output-names = "sleep_clk";
+		};
+
+		usb3_phy_wrapper_gcc_usb30_pipe_clk: usb3_phy_wrapper_gcc_usb30_pipe_clk {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <1000>;
+			clock-output-names = "usb3_phy_wrapper_gcc_usb30_pipe_clk";
+		};
+	};
+
+	cpus {
+		#address-cells = <2>;
+		#size-cells = <0>;
+
+		CPU0: cpu@0 {
+			device_type = "cpu";
+			compatible = "qcom,kryo260";
+			reg = <0x0 0x0>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <1024>;
+			next-level-cache = <&L2_0>;
+			L2_0: l2-cache {
+				compatible = "cache";
+			};
+		};
+
+		CPU1: cpu@1 {
+			device_type = "cpu";
+			compatible = "qcom,kryo260";
+			reg = <0x0 0x1>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <1024>;
+			next-level-cache = <&L2_0>;
+		};
+
+		CPU2: cpu@2 {
+			device_type = "cpu";
+			compatible = "qcom,kryo260";
+			reg = <0x0 0x2>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <1024>;
+			next-level-cache = <&L2_0>;
+		};
+
+		CPU3: cpu@3 {
+			device_type = "cpu";
+			compatible = "qcom,kryo260";
+			reg = <0x0 0x3>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <1024>;
+			next-level-cache = <&L2_0>;
+		};
+
+		CPU4: cpu@100 {
+			device_type = "cpu";
+			compatible = "qcom,kryo260";
+			reg = <0x0 0x100>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <1638>;
+			next-level-cache = <&L2_1>;
+			L2_1: l2-cache {
+				compatible = "cache";
+			};
+		};
+
+		CPU5: cpu@101 {
+			device_type = "cpu";
+			compatible = "qcom,kryo260";
+			reg = <0x0 0x101>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <1638>;
+			next-level-cache = <&L2_1>;
+		};
+
+		CPU6: cpu@102 {
+			device_type = "cpu";
+			compatible = "qcom,kryo260";
+			reg = <0x0 0x102>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <1638>;
+			next-level-cache = <&L2_1>;
+		};
+
+		CPU7: cpu@103 {
+			device_type = "cpu";
+			compatible = "qcom,kryo260";
+			reg = <0x0 0x103>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <1638>;
+			next-level-cache = <&L2_1>;
+		};
+
+		cpu-map {
+			cluster0 {
+				core0 {
+					cpu = <&CPU0>;
+				};
+
+				core1 {
+					cpu = <&CPU1>;
+				};
+
+				core2 {
+					cpu = <&CPU2>;
+				};
+
+				core3 {
+					cpu = <&CPU3>;
+				};
+			};
+
+			cluster1 {
+				core0 {
+					cpu = <&CPU4>;
+				};
+
+				core1 {
+					cpu = <&CPU5>;
+				};
+
+				core2 {
+					cpu = <&CPU6>;
+				};
+
+				core3 {
+					cpu = <&CPU7>;
+				};
+			};
+		};
+	};
+
+	firmware {
+		scm {
+			compatible = "qcom,scm-sm6115", "qcom,scm";
+		};
+	};
+
+	memory@40000000 {
+		/* We expect the bootloader to fill in the size */
+		reg = <0x0 0x40000000 0x0 0x0>;
+		device_type = "memory";
+	};
+
+	pmu {
+		compatible = "arm,armv8-pmuv3";
+		interrupts = <GIC_PPI 6 IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	psci {
+		compatible = "arm,psci-1.0";
+		method = "smc";
+	};
+
+	reserved_memory: reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		hyp_mem: memory@45700000 {
+			reg = <0x0 0x45700000 0x0 0x600000>;
+			no-map;
+		};
+
+		xbl_aop_mem: memory@45e00000 {
+			reg = <0x0 0x45e00000 0x0 0x140000>;
+			no-map;
+		};
+
+		sec_apps_mem: memory@45fff000 {
+			reg = <0x0 0x45fff000 0x0 0x1000>;
+			no-map;
+		};
+
+		smem_mem: memory@46000000 {
+			reg = <0x00 0x46000000 0x00 0x200000>;
+			no-map;
+		};
+
+		pil_modem_mem: modem_mem: memory@4ab00000 {
+			reg = <0x00 0x4ab00000 0x00 0x6900000>;
+			no-map;
+		};
+
+		wlan_msa_mem: wlan_msa_region: memory@51900000 {
+			reg = <0x00 0x51900000 0x00 0x100000>;
+			no-map;
+		};
+
+		/*
+		 * Modem EFS/NV shared memory — serviced by userspace rmtfsd
+		 * over QMI. Without this the modem's NV-dependent init stalls
+		 * and its internal watchdog fires ("DOG detects stalled
+		 * initialization"). Address is free space (not from Android,
+		 * which uses a dynamically-allocated downstream equivalent).
+		 */
+		rmtfs_mem: memory@51a00000 {
+			compatible = "qcom,rmtfs-mem";
+			/* Modem requests 0x300000 (3M) at runtime; 0x200000 (2M)
+			 * made rmtfs reject the allocation ("shared memory not
+			 * large enough") and modem crash-looped. Room until the
+			 * next carve-out (pil_adsp_region@0x53800000) is huge. */
+			reg = <0x00 0x51a00000 0x00 0x400000>;
+			no-map;
+
+			qcom,client-id = <1>;
+			qcom,vmid = <QCOM_SCM_VMID_MSS_MSA QCOM_SCM_VMID_NAV>;
+		};
+
+		cdsp_mem: memory@46200000 {
+			reg = <0x00 0x46200000 0x00 0x1e00000>;
+			no-map;
+		};
+
+		pil_adsp_region: memory@53800000 {
+			reg = <0x00 0x53800000 0x00 0x1e00000>;
+			no-map;
+		};
+
+		ipa_fw_region: memory@55600000 {
+			reg = <0x00 0x55600000 0x00 0x10000>;
+			no-map;
+		};
+
+		ipa_gsi_region: memory@55610000 {
+			reg = <0x00 0x55610000 0x00 0x5000>;
+			no-map;
+		};
+
+		/* Android rain: gpu_region@56615000 (zap PIL); was wrong @55615000 */
+		pil_gpu_mem: gpu_region: memory@56615000 {
+			reg = <0x00 0x56615000 0x00 0x2000>;
+			no-map;
+		};
+
+		cont_splash_mem: memory@5c000000 {
+			reg = <0x0 0x5c000000 0x0 0x00f00000>;
+			no-map;
+		};
+
+		dfps_data_mem: memory@5cf00000 {
+			reg = <0x0 0x5cf00000 0x0 0x0100000>;
+			no-map;
+		};
+
+		qseecom_mem: memory@5e400000 {
+			reg = <0x0 0x5e400000 0x0 0x1400000>;
+			no-map;
+		};
+
+		sdsp_mem: memory@f3000000 {
+			reg = <0x0 0xf3000000 0x0 0x400000>;
+			no-map;
+		};
+
+		adsp_mem: memory@f3400000 {
+			reg = <0x0 0xf3400000 0x0 0x800000>;
+			no-map;
+		};
+
+		qseecom_ta_mem: memory@13fc00000 {
+			reg = <0x1 0x3fc00000 0x0 0x400000>;
+			no-map;
+		};
+	};
+
+	smem: smem {
+		compatible = "qcom,smem";
+		memory-region = <&smem_mem>;
+		hwlocks = <&tcsr_mutex 3>;
+		qcom,rpm-msg-ram = <&rpm_msg_ram>;
+	};
+
+	/*
+	 * Modem SMP2P — needed by remoteproc_mpss / ath10k_snoc (WCN3990).
+	 * Same layout as upstream sm6115.dtsi.
+	 */
+	smp2p-mpss {
+		compatible = "qcom,smp2p";
+		qcom,smem = <435>, <428>;
+		interrupts = <GIC_SPI 70 IRQ_TYPE_EDGE_RISING>;
+		mboxes = <&apcs_glb 14>;
+		qcom,local-pid = <0>;
+		qcom,remote-pid = <1>;
+
+		modem_smp2p_out: master-kernel {
+			qcom,entry-name = "master-kernel";
+			#qcom,smem-state-cells = <1>;
+		};
+
+		modem_smp2p_in: slave-kernel {
+			qcom,entry-name = "slave-kernel";
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+
+		/* WLAN early-crash / fatal from MPSS (Android icnss) */
+		smp2p_wlan_1_in: wlan {
+			qcom,entry-name = "wlan";
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+	};
+
+	/* RPM over GLINK — step 2 PMIC regulators (no GCC yet) */
+	rpm: remoteproc {
+		compatible = "qcom,sm6115-rpm-proc", "qcom,rpm-proc";
+
+		glink-edge {
+			compatible = "qcom,glink-rpm";
+			interrupts = <GIC_SPI 194 IRQ_TYPE_EDGE_RISING>;
+			qcom,rpm-msg-ram = <&rpm_msg_ram>;
+			mboxes = <&apcs_glb 0>;
+
+			rpm_requests: rpm-requests {
+				compatible = "qcom,rpm-sm6115", "qcom,glink-smd-rpm";
+				qcom,glink-channels = "rpm_requests";
+
+				rpmcc: clock-controller {
+					compatible = "qcom,rpmcc-sm6115", "qcom,rpmcc";
+					clocks = <&xo_board>;
+					clock-names = "xo";
+					#clock-cells = <1>;
+				};
+
+				rpmpd: power-controller {
+					compatible = "qcom,sm6115-rpmpd";
+					#power-domain-cells = <1>;
+					operating-points-v2 = <&rpmpd_opp_table>;
+
+					rpmpd_opp_table: opp-table {
+						compatible = "operating-points-v2";
+
+						rpmpd_opp_min_svs: opp1 {
+							opp-level = <RPM_SMD_LEVEL_MIN_SVS>;
+						};
+						rpmpd_opp_low_svs: opp2 {
+							opp-level = <RPM_SMD_LEVEL_LOW_SVS>;
+						};
+						rpmpd_opp_svs: opp3 {
+							opp-level = <RPM_SMD_LEVEL_SVS>;
+						};
+						rpmpd_opp_svs_plus: opp4 {
+							opp-level = <RPM_SMD_LEVEL_SVS_PLUS>;
+						};
+						rpmpd_opp_nom: opp5 {
+							opp-level = <RPM_SMD_LEVEL_NOM>;
+						};
+						rpmpd_opp_nom_plus: opp6 {
+							opp-level = <RPM_SMD_LEVEL_NOM_PLUS>;
+						};
+						rpmpd_opp_turbo: opp7 {
+							opp-level = <RPM_SMD_LEVEL_TURBO>;
+						};
+						rpmpd_opp_turbo_plus: opp8 {
+							opp-level = <RPM_SMD_LEVEL_TURBO_NO_CPR>;
+						};
+					};
+				};
+			};
+		};
+	};
+
+		soc {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0x00 0x00 0x00 0xffffffff>;
+		compatible = "simple-bus";
+
+		/*
+		 * Khaje TLMM — Android rain: qcom,khaje-pinctrl @0x400000/0xc00000.
+		 * sm6115 tiled @0x5/9/d00000 caused BACK_FB even without IRQ.
+		 */
+		tlmm: pinctrl@400000 {
+			compatible = "qcom,khaje-pinctrl";
+			reg = <0x00400000 0xc00000>;
+			/* Android rain: <0 0xe3 4> == GIC_SPI 227 LEVEL_HIGH */
+			interrupts = <GIC_SPI 227 IRQ_TYPE_LEVEL_HIGH>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			gpio-ranges = <&tlmm 0 0 102>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			/* wakeup-parent/PDC later — summary only for bringup */
+
+			qup_i2c1_default: qup-i2c1-default-state {
+				pins = "gpio4", "gpio5";
+				function = "qup1";
+				drive-strength = <2>;
+				bias-pull-up;
+			};
+
+			qup_i2c2_default: qup-i2c2-default-state {
+				pins = "gpio6", "gpio7";
+				function = "qup2";
+				drive-strength = <2>;
+				bias-pull-up;
+			};
+
+			/* SPI0 pins as GPIO for spi-gpio bitbang (GENI FIFO fused off) */
+			qup_spi0_gpio: qup-spi0-gpio-state {
+				pins = "gpio0", "gpio1", "gpio2", "gpio3";
+				function = "gpio";
+				drive-strength = <6>;
+				bias-disable;
+			};
+
+			/* SPI0 (GENI SE0) — Android rain qupv3_se0_spi: gpio0-3 qup0 */
+			qup_spi0_default: qup-spi0-default-state {
