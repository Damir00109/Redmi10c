+#define FTS_FLASH_PACKET_LENGTH_SPI                 (32 * 1024 - 16)
+
+#if LCT_TP_USB_PLUGIN
+extern touchscreen_usb_plugin_data_t g_touchscreen_usb_pulgin;
+#endif
+
