diff --git a/drivers/input/touchscreen/fts_spi/focaltech_gesture.c b/drivers/input/touchscreen/fts_spi/focaltech_gesture.c
new file mode 100644
index 000000000..35661f884
--- /dev/null
+++ b/drivers/input/touchscreen/fts_spi/focaltech_gesture.c
@@ -0,0 +1,477 @@
+/*
+ *
+ * FocalTech TouchScreen driver.
+ *
+ * Copyright (c) 2012-2020, Focaltech Ltd. All rights reserved.
+ *
