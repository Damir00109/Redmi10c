+/*
+ * Thin DT has no qcom,gcc-sm6115 — enable USB30 GDSC + AHB2PHY via MMIO
+ * before Femto register poke (otherwise power_on writes go nowhere and
+ * DWC3 later hits "failed to enable ep0out").
+ */
+static void qcom_snps_hsphy_force_usb_clks(struct device *dev)
+{
+	void __iomem *gcc;
+	u32 v;
+	int i;
+
+	gcc = ioremap(0x01400000, 0x20000);
+	if (!gcc) {
+		dev_err(dev, "rain: cannot map GCC for USB clocks\n");
+		return;
+	}
+
+	/* USB30_PRIM_GDSC @ 0x1a004: clear SW_COLLAPSE, wait PWR_ON */
+	v = readl(gcc + 0x1a004);
+	writel(v & ~BIT(0), gcc + 0x1a004);
+	for (i = 0; i < 200; i++) {
+		if (readl(gcc + 0x1a004) & BIT(31))
+			break;
+		udelay(50);
+	}
+
+	writel(1, gcc + 0x1a014);	/* GCC_USB30_PRIM_SLEEP_CLK */
+	writel(1, gcc + 0x1a010);	/* GCC_USB30_PRIM_MASTER_CLK */
+	writel(1, gcc + 0x1a018);	/* GCC_USB30_PRIM_MOCK_UTMI_CLK */
+	writel(0, gcc + 0x1d000);	/* GCC_USB_PHY_CFG_AHB2PHY_BCR deassert */
+	writel(3, gcc + 0x1d008);	/* GCC_AHB2PHY_USB_CLK */
+
+	dev_info(dev, "rain: usb gdsc=0x%08x ahb2phy=0x%08x\n",
+		 readl(gcc + 0x1a004), readl(gcc + 0x1d008));
+	iounmap(gcc);
+}
+
 static int qcom_snps_hsphy_init(struct phy *phy)
 {
 	struct qcom_snps_hsphy *hsphy = phy_get_drvdata(phy);
@@ -390,6 +427,8 @@ static int qcom_snps_hsphy_init(struct phy *phy)
 
 	dev_vdbg(&phy->dev, "%s(): Initializing SNPS HS phy\n", __func__);
 
+	qcom_snps_hsphy_force_usb_clks(&phy->dev);
+
 	ret = regulator_bulk_enable(ARRAY_SIZE(hsphy->vregs), hsphy->vregs);
 	if (ret)
 		return ret;
@@ -584,7 +623,8 @@ static int qcom_snps_hsphy_probe(struct platform_device *pdev)
