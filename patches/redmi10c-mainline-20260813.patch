diff --git a/drivers/gpu/drm/panel/panel-xinli-ft8006s.c b/drivers/gpu/drm/panel/panel-xinli-ft8006s.c
new file mode 100644
index 000000000..5dbc807fb
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-xinli-ft8006s.c
@@ -0,0 +1,336 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Xinli FT8006S — Redmi 10C NFC (fog/rain), video-mode panel (no GRAM).
+ * Timings and DCS from Android dsi_panel_c3q_43_03_0b_fhdp_video.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+#include <video/mipi_display.h>
+
+/*
+ * Android bl_inverted_dbv is a byte swap, not a value inversion:
+ * 0 = off, 0x7ff = max. Default 30% to avoid overcurrent lockup.
+ */
+#define FT8006S_BL_DEFAULT	0x266
+#define FT8006S_BL_MAX		0x7ff
+
+struct xinli_ft8006s {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *enp_gpio;
+	struct gpio_desc *enn_gpio;
+	struct regulator *vddio;
+	bool prepared;
+};
+
+static inline struct xinli_ft8006s *to_xinli_ft8006s(struct drm_panel *panel)
+{
+	return container_of(panel, struct xinli_ft8006s, panel);
+}
+
+/*
+ * Android bl_ctrl_dcs: bl_move_high_8b + bl_inverted_dbv.
+ * 0x7ff → wire "51 ff 0e".
+ */
+static u16 xinli_ft8006s_bl_pack(u16 brightness)
+{
+	u32 val = (u32)brightness << 5;
+
+	val = (val & 0xff00) | ((val & 0xe0) >> 4);
+	return ((val & 0xff) << 8) | (val >> 8);
+}
+
+static void xinli_ft8006s_bias_on(struct xinli_ft8006s *ctx)
+{
+	if (ctx->enp_gpio) {
+		gpiod_set_value_cansleep(ctx->enp_gpio, 1);
+		usleep_range(5000, 6000);
+	}
+	if (ctx->enn_gpio) {
+		gpiod_set_value_cansleep(ctx->enn_gpio, 1);
+		usleep_range(5000, 6000);
+	}
+}
+
+static void xinli_ft8006s_bias_off(struct xinli_ft8006s *ctx)
+{
+	if (ctx->enn_gpio)
+		gpiod_set_value_cansleep(ctx->enn_gpio, 0);
+	if (ctx->enp_gpio)
+		gpiod_set_value_cansleep(ctx->enp_gpio, 0);
+}
+
+/* Android reset-sequence <1 5 0 5 1 35> */
+static void xinli_ft8006s_reset(struct xinli_ft8006s *ctx)
+{
+	if (!ctx->reset_gpio)
+		return;
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(5000, 6000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(5000, 6000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	msleep(35);
+}
+
+static int xinli_ft8006s_on(struct xinli_ft8006s *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x41, 0x5a, 0x19);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x80, 0xe3, 0xd4, 0xc4, 0xb6,
+				     0xac, 0xa3, 0x9c, 0x96, 0x90, 0x8c, 0x88,
+				     0x83, 0x44, 0x74, 0xfb, 0x9f);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x90, 0xf9, 0x0f, 0xfe, 0xef,
+				     0x9f, 0xaf, 0x0f);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xa0, 0x00, 0x00, 0x46, 0x00);
+
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY,
+				     0x2c);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_POWER_SAVE, 0x00);
+	mipi_dsi_dcs_set_display_brightness_multi(&dsi_ctx,
+						xinli_ft8006s_bl_pack(FT8006S_BL_DEFAULT));
+	mipi_dsi_msleep(&dsi_ctx, 10);
+
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	return dsi_ctx.accum_err;
+}
+
+static int xinli_ft8006s_off(struct xinli_ft8006s *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	return dsi_ctx.accum_err;
+}
+
+static int xinli_ft8006s_prepare(struct drm_panel *panel)
+{
+	struct xinli_ft8006s *ctx = to_xinli_ft8006s(panel);
+	int ret;
+
+	if (ctx->prepared)
+		return 0;
+
+	if (ctx->vddio) {
+		ret = regulator_enable(ctx->vddio);
+		if (ret)
+			return ret;
+		msleep(20);
+	}
+
+	xinli_ft8006s_bias_on(ctx);
+	xinli_ft8006s_reset(ctx);
+
+	ret = xinli_ft8006s_on(ctx);
+	if (ret < 0) {
+		dev_err(panel->dev, "panel on failed: %d\n", ret);
+		if (ctx->reset_gpio)
+			gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+		xinli_ft8006s_bias_off(ctx);
+		if (ctx->vddio)
+			regulator_disable(ctx->vddio);
+		return ret;
+	}
+
+	ctx->prepared = true;
+	return 0;
+}
+
+static int xinli_ft8006s_unprepare(struct drm_panel *panel)
+{
+	struct xinli_ft8006s *ctx = to_xinli_ft8006s(panel);
+
+	if (!ctx->prepared)
+		return 0;
+
+	xinli_ft8006s_off(ctx);
+	if (ctx->reset_gpio)
+		gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	xinli_ft8006s_bias_off(ctx);
+	if (ctx->vddio)
+		regulator_disable(ctx->vddio);
+
+	ctx->prepared = false;
+	return 0;
+}
+
+/* 720x1650@60 → clock 89954 (Android 720x1650x60x89954vid) */
+static const struct drm_display_mode xinli_ft8006s_mode = {
+	.clock = (720 + 26 + 16 + 25) * (1650 + 135 + 10 + 110) * 60 / 1000,
+	.hdisplay = 720,
+	.hsync_start = 720 + 26,
+	.hsync_end = 720 + 26 + 16,
+	.htotal = 720 + 26 + 16 + 25,
+	.vdisplay = 1650,
+	.vsync_start = 1650 + 135,
+	.vsync_end = 1650 + 135 + 10,
+	.vtotal = 1650 + 135 + 10 + 110,
+	.width_mm = 68,
+	.height_mm = 156,
+};
+
+static int xinli_ft8006s_get_modes(struct drm_panel *panel,
+				   struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &xinli_ft8006s_mode);
+	if (!mode)
+		return -ENOMEM;
+
+	drm_mode_set_name(mode);
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+	drm_mode_probed_add(connector, mode);
+	return 1;
+}
+
+static const struct drm_panel_funcs xinli_ft8006s_funcs = {
+	.prepare = xinli_ft8006s_prepare,
+	.unprepare = xinli_ft8006s_unprepare,
+	.get_modes = xinli_ft8006s_get_modes,
+};
+
+static int xinli_ft8006s_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+	int ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_set_display_brightness(dsi,
+						   xinli_ft8006s_bl_pack(brightness));
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	return ret;
+}
+
+static const struct backlight_ops xinli_ft8006s_bl_ops = {
+	.update_status = xinli_ft8006s_bl_update_status,
+};
+
+static int xinli_ft8006s_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct xinli_ft8006s *ctx;
+	struct backlight_device *bl;
+	int ret;
+
+	ctx = devm_kzalloc(dev, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	ctx->vddio = devm_regulator_get_optional(dev, "vddio");
+	if (IS_ERR(ctx->vddio)) {
+		ret = PTR_ERR(ctx->vddio);
+		if (ret != -ENODEV)
+			return dev_err_probe(dev, ret, "vddio\n");
+		ctx->vddio = NULL;
+	}
+
+	ctx->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio), "reset\n");
+
+	ctx->enp_gpio = devm_gpiod_get_optional(dev, "enp", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->enp_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->enp_gpio), "enp\n");
+
+	ctx->enn_gpio = devm_gpiod_get_optional(dev, "enn", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->enn_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->enn_gpio), "enn\n");
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	/* Android: non_burst_sync_event, no force-clock-lane-hs, no EOT */
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS |
+			  MIPI_DSI_MODE_NO_EOT_PACKET;
+
+	drm_panel_init(&ctx->panel, dev, &xinli_ft8006s_funcs,
+		       DRM_MODE_CONNECTOR_DSI);
+	ctx->panel.prepare_prev_first = true;
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return ret;
+	if (!ctx->panel.backlight) {
+		const struct backlight_properties props = {
+			.type = BACKLIGHT_RAW,
+			.brightness = FT8006S_BL_DEFAULT,
+			.max_brightness = FT8006S_BL_MAX,
+		};
+
+		bl = devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+						    &xinli_ft8006s_bl_ops, &props);
+		if (IS_ERR(bl))
+			return PTR_ERR(bl);
+		ctx->panel.backlight = bl;
+	}
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void xinli_ft8006s_remove(struct mipi_dsi_device *dsi)
+{
+	struct xinli_ft8006s *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id xinli_ft8006s_of_match[] = {
+	{ .compatible = "xinli,ft8006s" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, xinli_ft8006s_of_match);
+
+static struct mipi_dsi_driver xinli_ft8006s_driver = {
+	.probe = xinli_ft8006s_probe,
+	.remove = xinli_ft8006s_remove,
+	.driver = {
+		.name = "panel-xinli-ft8006s",
+		.of_match_table = xinli_ft8006s_of_match,
+	},
+};
+module_mipi_dsi_driver(xinli_ft8006s_driver);
+
+MODULE_AUTHOR("Redmi 10C bringup");
+MODULE_DESCRIPTION("Xinli FT8006S video-mode DSI panel");
+MODULE_LICENSE("GPL");
