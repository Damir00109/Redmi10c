+static int gpu_cc_sm6225_probe(struct platform_device *pdev)
+{
+	struct regmap *regmap;
+	u32 val;
+	int ret;
+
+	regmap = qcom_cc_map(pdev, &gpu_cc_sm6225_desc);
+	if (IS_ERR(regmap))
+		return PTR_ERR(regmap);
+
+	/*
+	 * Enable the CX GDSC (GPU_CX_GDSC at 0x106c) so the PLLs have power.
+	 * Also enable the AHB and CXO branch clocks — the AHB clock (0x1078)
+	 * is needed for register access to the GPU CC block, and the CXO
+	 * clock (0x1060) provides the PLL reference input.  Without CXO,
+	 * the PLLs will never lock.  These match the downstream Khaje
+	 * driver's always-on clock handling.
+	 */
+	regmap_write(regmap, 0x106c, 0);  /* GPU_CX_GDSC: SW_COLLAPSE = 0 */
+	ret = regmap_read_poll_timeout(regmap, 0x106c, val, (val & BIT(31)),
+				       1, 100);
+	if (ret)
+		pr_warn("gpucc-sm6225: CX GDSC enable timed out: 0x%x\n", val);
+	else
+		pr_info("gpucc-sm6225: CX GDSC enabled: 0x%x\n", val);
+
+	/* Keep AHB and CXO clocks always-on (matches downstream Khaje) */
+	qcom_branch_set_clk_en(regmap, 0x1078); /* GPU_CC_AHB_CLK */
+	qcom_branch_set_clk_en(regmap, 0x1060); /* GPU_CC_GX_CXO_CLK */
+
+	/* PLL0 is ZONDA, PLL1 is LUCID — matching downstream Khaje */
+	clk_zonda_pll_configure(&gpu_cc_pll0, regmap, &gpu_cc_pll0_config);
+	clk_lucid_pll_configure(&gpu_cc_pll1, regmap, &gpu_cc_pll1_config);
+
+	/* Set recommended WAKEUP/SLEEP settings for the gpu_cc_cx_gmu_clk */
+	qcom_branch_set_wakeup(regmap, gpu_cc_cx_gmu_clk, 0xf);
+	qcom_branch_set_sleep(regmap, gpu_cc_cx_gmu_clk, 0xf);
+
+	qcom_branch_set_force_mem_core(regmap, gpu_cc_gx_gfx3d_clk, true);
+	qcom_branch_set_force_periph_on(regmap, gpu_cc_gx_gfx3d_clk, true);
+
+	return qcom_cc_really_probe(&pdev->dev, &gpu_cc_sm6225_desc, regmap);
+}
+
+static struct platform_driver gpu_cc_sm6225_driver = {
+	.probe = gpu_cc_sm6225_probe,
