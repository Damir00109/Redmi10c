diff --git a/arch/arm64/boot/dts/qcom/sm6225-xiaomi-fog-sm6115.dts b/arch/arm64/boot/dts/qcom/sm6225-xiaomi-fog-sm6115.dts
new file mode 100644
index 000000000..b709124c7
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm6225-xiaomi-fog-sm6115.dts
@@ -0,0 +1,149 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2026 Damir00109 <internet00109@gmail.com>
+ * https://github.com/Damir00109/Redmi10c
+ */
+/*
+ * Xiaomi Redmi 10C (fog/rain) — SM6225/Khaje on sm6115.dtsi + pm6125.
+ * Step 1: PMIC regulators + USB (Femto HS, UTMI-as-pipe). UFS/GPU off until ACM stable.
+ */
+/dts-v1/;
+
+#include "sm6115.dtsi"
+#include "pm6125.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/clock/qcom,rpmcc.h>
+
+/ {
+	qcom,msm-id = <0x206 0x10000>;
+	qcom,board-id = <0x60022 0x00>;
+	model = "Xiaomi Redmi 10C fog/rain (sm6115+pm6125)";
+	compatible = "xiaomi,fog", "qcom,sm6225", "qcom,sm6115";
+	chassis-type = "handset";
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		bootargs = "console=tty0 earlycon clk_ignore_unused pd_ignore_unused";
+		framebuffer0: framebuffer@5c000000 {
+			compatible = "simple-framebuffer";
+			reg = <0 0x5c000000 0 (1650 * 720 * 4)>;
+			width = <720>;
+			height = <1650>;
+			stride = <(720 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	/* Keep splash carveout from ABL */
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		framebuffer_region: memory@5c000000 {
+			reg = <0 0x5c000000 0 0x1000000>;
+			no-map;
+		};
+	};
+};
+
+/* Heavy / unused for this step */
+&wifi { status = "disabled"; };
+&ufs_mem_hc { status = "disabled"; };
+&ufs_mem_phy { status = "disabled"; };
+&gpu { status = "disabled"; };
+&gmu_wrapper { status = "disabled"; };
+&mdss { status = "disabled"; };
+&mdss_dsi0 { status = "disabled"; };
+&remoteproc_adsp { status = "disabled"; };
+&remoteproc_cdsp { status = "disabled"; };
+&remoteproc_mpss { status = "disabled"; };
+&sdhc_1 { status = "disabled"; };
+&sdhc_2 { status = "disabled"; };
+&gpi_dma0 { status = "disabled"; };
+&qupv3_id_0 { status = "disabled"; };
+&cryptobam { status = "disabled"; };
+&crypto { status = "disabled"; };
+&usb_qmpphy { status = "disabled"; };
+/* SMMU often hangs early on partial bring-up; UFS/GPU need it later */
+&apps_smmu { status = "disabled"; };
+&adreno_smmu { status = "disabled"; };
+&tsens0 { status = "disabled"; };
+&lpass_tlmm { status = "disabled"; };
+
+/* RPM SMD regulators (pm6125) — USB / future UFS rails */
+&rpm_requests {
+	regulators-0 {
+		compatible = "qcom,rpm-pm6125-regulators";
+
+		pm6125_l4a: l4 {
+			regulator-min-microvolt = <488000>;
+			regulator-max-microvolt = <1000000>;
+		};
+
+		pm6125_l11a: l11 {
+			regulator-min-microvolt = <1704000>;
+			regulator-max-microvolt = <1952000>;
+			regulator-allow-set-load;
+		};
+
+		pm6125_l12a: l12 {
+			regulator-min-microvolt = <1624000>;
+			regulator-max-microvolt = <1984000>;
+		};
+
+		pm6125_l15a: l15 {
+			regulator-min-microvolt = <2920000>;
+			regulator-max-microvolt = <3232000>;
+		};
+
+		pm6125_l18a: l18 {
+			regulator-min-microvolt = <1704000>;
+			regulator-max-microvolt = <1904000>;
+		};
+
+		pm6125_l24a: l24 {
+			regulator-min-microvolt = <1104000>;
+			regulator-max-microvolt = <1304000>;
+			regulator-allow-set-load;
+		};
+	};
+};
+
+&pon_pwrkey {
+	status = "okay";
+};
+
+/* USB: qcom wrapper + Femto (Khaje), not sm6115 QUSB2 */
+&usb {
+	status = "okay";
+	qcom,select-utmi-as-pipe-clk;
+	/delete-property/ interconnects;
+	/delete-property/ interconnect-names;
+};
+
+&usb_dwc3 {
+	dr_mode = "peripheral";
+	phys = <&usb_hsphy>;
+	phy-names = "usb2-phy";
+	maximum-speed = "high-speed";
+	/delete-property/ usb-role-switch;
+	/delete-property/ iommus;
+};
+
+&usb_hsphy {
+	compatible = "qcom,usb-snps-femto-v2-phy";
+	/* Femto: ref + optional cfg_ahb; supplies vdda-pll / vdda33 / vdda18 */
+	clocks = <&rpmcc RPM_SMD_XO_CLK_SRC>, <&gcc GCC_AHB2PHY_USB_CLK>;
+	clock-names = "ref", "cfg_ahb";
+	resets = <&gcc GCC_QUSB2PHY_PRIM_BCR>;
+	vdda-pll-supply = <&pm6125_l12a>;
+	vdda18-supply = <&pm6125_l12a>;
+	vdda33-supply = <&pm6125_l15a>;
+	/delete-property/ nvmem-cells;
+	/delete-property/ nvmem-cell-names;
+	/delete-property/ vdd-supply;
+	/delete-property/ vdda-phy-dpdm-supply;
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/qcom/sm6225-xiaomi-fog.dts b/arch/arm64/boot/dts/qcom/sm6225-xiaomi-fog.dts
