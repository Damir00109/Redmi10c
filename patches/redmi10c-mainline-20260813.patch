 	qcom_smmu_tlb_sync_debug(smmu);
 }
 
+static void qcom_smmu_write_sctlr(struct arm_smmu_device *smmu, int idx,
+		u32 reg)
+{
+	/*
+	 * Set HUPCF (Hold Up Client Faults) on all context banks so that
+	 * subsequent transactions are processed after a fault.  Without this,
+	 * a fault on the display/DPU context bank (SID 0x420/0x421) stalls
+	 * the SMMU and hangs the whole system — the phone freezes with no
+	 * kernel panic.  This matches downstream's
+	 * qcom,iommu-faults = "non-fatal" on the display SMMU context banks.
+	 */
+	reg |= ARM_SMMU_SCTLR_HUPCF;
+
+	arm_smmu_cb_write(smmu, idx, ARM_SMMU_CB_SCTLR, reg);
+}
+
 static void qcom_adreno_smmu_write_sctlr(struct arm_smmu_device *smmu, int idx,
 		u32 reg)
 {
