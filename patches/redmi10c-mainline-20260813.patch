diff --git a/drivers/clk/qcom/clk-alpha-pll.c b/drivers/clk/qcom/clk-alpha-pll.c
index f8313f9d0..67c2115fd 100644
--- a/drivers/clk/qcom/clk-alpha-pll.c
+++ b/drivers/clk/qcom/clk-alpha-pll.c
@@ -1819,9 +1819,22 @@ static int __alpha_pll_trion_set_rate(struct clk_hw *hw, unsigned long rate,
 	/* Wait for 2 reference cycles before checking the ACK bit. */
 	udelay(1);
 	regmap_read(pll->clkr.regmap, PLL_MODE(pll), &val);
-	if (!(val & latch_ack)) {
-		pr_err("Lucid PLL latch failed. Output may be unstable!\n");
-		return -EINVAL;
+
+	/*
+	 * Some Lucid/Trion hardware auto-clears the latch bit and uses
+	 * PLL_UPDATE_BYPASS to select between the legacy ACK latch and the
+	 * auto-clear path.  When bypass is not set, wait for the latch bit to
+	 * clear; otherwise wait for the ACK bit to be set.
+	 */
+	if (val & PLL_UPDATE_BYPASS) {
+		if (!(val & latch_ack)) {
+			pr_err("Lucid PLL latch failed. Output may be unstable!\n");
+			return -EINVAL;
+		}
+	} else {
+		ret = wait_for_pll(pll, latch_bit, true, "latch clear");
+		if (ret)
+			return ret;
 	}
 
 	/* Return the latch input to 0 */
diff --git a/drivers/clk/qcom/dispcc-sm6375.c b/drivers/clk/qcom/dispcc-sm6375.c
index ec9dbb1f4..767d4ae1f 100644
--- a/drivers/clk/qcom/dispcc-sm6375.c
+++ b/drivers/clk/qcom/dispcc-sm6375.c
@@ -568,8 +568,30 @@ static const struct qcom_cc_desc disp_cc_sm6375_desc = {
 	.num_gdscs = ARRAY_SIZE(disp_cc_sm6375_gdscs),
 };
 
+/*
+ * Khaje Android dispcc treats GDSCR@0x1004 as HW-managed (mdss_gdsc has
+ * qcom,support-hw-trigger in the vendor DT) and mainline previously left
+ * it unreferenced here on that basis. Re-testing (2026-08-13): expose it
+ * as a normal power-domain like sm6375 — HW_CTRL is already set on
+ * mdss_gdsc, so the generic gdsc framework should just vote for hardware
+ * auto-control rather than fight it; this is not expected to change
+ * ABL's hand-off behavior, only make Linux's own vote correct if it turns
+ * out something *does* need a SW-visible poke.
+ */
+static const struct qcom_cc_desc disp_cc_sm6225_desc = {
+	.config = &disp_cc_sm6375_regmap_config,
+	.clks = disp_cc_sm6375_clocks,
+	.num_clks = ARRAY_SIZE(disp_cc_sm6375_clocks),
+	.resets = disp_cc_sm6375_resets,
+	.num_resets = ARRAY_SIZE(disp_cc_sm6375_resets),
+	.gdscs = disp_cc_sm6375_gdscs,
+	.num_gdscs = ARRAY_SIZE(disp_cc_sm6375_gdscs),
+};
+
 static const struct of_device_id disp_cc_sm6375_match_table[] = {
 	{ .compatible = "qcom,sm6375-dispcc" },
+	/* Khaje/SM6225: same Lucid map as SM6375 (Android dispcc-khaje) */
+	{ .compatible = "qcom,sm6225-dispcc" },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, disp_cc_sm6375_match_table);
@@ -577,14 +599,25 @@ MODULE_DEVICE_TABLE(of, disp_cc_sm6375_match_table);
 static int disp_cc_sm6375_probe(struct platform_device *pdev)
 {
 	struct regmap *regmap;
+	const struct qcom_cc_desc *desc = &disp_cc_sm6375_desc;
+
+	if (of_device_is_compatible(pdev->dev.of_node, "qcom,sm6225-dispcc"))
+		desc = &disp_cc_sm6225_desc;
 
-	regmap = qcom_cc_map(pdev, &disp_cc_sm6375_desc);
+	regmap = qcom_cc_map(pdev, desc);
 	if (IS_ERR(regmap))
 		return PTR_ERR(regmap);
 
+	/* Skip reconfig if ABL already left Lucid PLL enabled (trion helper). */
 	clk_lucid_pll_configure(&disp_cc_pll0, regmap, &disp_cc_pll0_config);
 
-	return qcom_cc_really_probe(&pdev->dev, &disp_cc_sm6375_desc, regmap);
+	/* Khaje vendor: keep XO/SLEEP always-on */
+	if (desc == &disp_cc_sm6225_desc) {
+		regmap_update_bits(regmap, 0x5004, BIT(0), BIT(0));
+		regmap_update_bits(regmap, 0x5008, BIT(0), BIT(0));
+	}
+
+	return qcom_cc_really_probe(&pdev->dev, desc, regmap);
 }
 
