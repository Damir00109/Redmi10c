+static bool fts_check_id(u8 idh, u8 idl, bool is_boot)
+{
+    if (is_boot) {
+        if (((idh == 0x86) && (idl == 0x32)) ||
+            ((idh == 0x86) && (idl == 0x42)) ||
+            ((idh == 0x86) && (idl == 0xC2)) ||
+            ((idh == 0x86) && (idl == 0xE2)) ||
+            ((idh == 0xF0) && (idl == 0xC6)) ||
+            ((idh == 0xF0) && (idl == 0xD6))) {
+            FTS_INFO("check id pass, id:0x%02x%02x", idh, idl);
+            return true;
+        }
+    } else {
+        if (((idh == 0x86) && (idl == 0x32)) ||
+            ((idh == 0x86) && (idl == 0x42)) ||
+            ((idh == 0x80) && (idl == 0x17)) ||
+            ((idh == 0x80) && (idl == 0x16)) ||
+            ((idh == 0xF0) && (idl == 0xC6))) {
+            FTS_INFO("check id pass, id:0x%02x%02x", idh, idl);
+            return true;
+        }
+    }
+
+    return false;
+}
