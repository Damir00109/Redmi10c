+/*
+ * Bootloader may leave INTF scanning the splash FB. Attaching the kernel
+ * IOMMU domain then causes SMMU faults that wedge CTL_SW_RESET forever.
+ * Stop scanout before the domain swap (video panels have no GRAM).
+ */
+static void dpu_kms_stop_boot_scanout(struct dpu_kms *dpu_kms)
+{
+	const struct dpu_mdss_cfg *catalog = dpu_kms->catalog;
+	unsigned int i;
+
+	for (i = 0; i < catalog->intf_count; i++) {
+		if (readl_relaxed(dpu_kms->mmio + catalog->intf[i].base)) {
+			DPU_DEBUG("stopping bootloader scanout on intf %u\n", i);
+			writel_relaxed(0, dpu_kms->mmio + catalog->intf[i].base);
+		}
+	}
+	wmb();
+	usleep_range(20000, 25000);
+}
