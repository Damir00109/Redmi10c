+static bool msm_gpio_is_reserved(struct msm_pinctrl *pctrl, unsigned int gpio)
+{
+	const int *reserved = pctrl->soc->reserved_gpios;
+	int i;
+
+	if (!reserved)
+		return false;
+
+	for (i = 0; reserved[i] >= 0; i++) {
+		if ((unsigned int)reserved[i] == gpio)
+			return true;
+	}
+
+	return false;
+}
+
+/*
+ * Mask+ack IRQs on safe GPIOs before gpiochip_add enables the summary IRQ.
+ * Do not touch reserved tiles (khaje EAST/SOUTH MMIO hangs).
+ */
+static void msm_gpio_irq_quiesce(struct msm_pinctrl *pctrl)
+{
+	const struct msm_pingroup *g;
+	unsigned int i, ngpio = pctrl->soc->ngpios;
+	unsigned long flags;
+	u32 val;
+
+	for (i = 0; i < ngpio; i++) {
+		if (msm_gpio_is_reserved(pctrl, i))
+			continue;
+
+		g = &pctrl->soc->groups[i];
+		if (g->intr_detection_width != 1 &&
+		    g->intr_detection_width != 2)
+			continue;
+
+		raw_spin_lock_irqsave(&pctrl->lock, flags);
+		val = msm_readl_intr_cfg(pctrl, g);
