@@ -1045,6 +1045,9 @@ static void msm_gpio_irq_init_valid_mask(struct gpio_chip *gc,
 		if (g->intr_detection_width != 1 &&
 		    g->intr_detection_width != 2)
 			clear_bit(i, valid_mask);
+		/* Khaje: skip EAST/SOUTH reserved lines (MMIO hang). */
+		if (!gpiochip_line_is_valid(gc, i))
+			clear_bit(i, valid_mask);
 	}
 }
 
@@ -1400,6 +1403,52 @@ static const struct irq_chip msm_gpio_irq_chip = {
 				   IRQCHIP_IMMUTABLE),
 };
 
+static bool msm_gpio_is_reserved(struct msm_pinctrl *pctrl, unsigned int gpio)
+{
+	const int *reserved = pctrl->soc->reserved_gpios;
+	int i;
+
+	if (!reserved)
+		return false;
+
+	for (i = 0; reserved[i] >= 0; i++) {
+		if ((unsigned int)reserved[i] == gpio)
+			return true;
+	}
+
+	return false;
+}
+
+/*
+ * Mask+ack IRQs on safe GPIOs before gpiochip_add enables the summary IRQ.
+ * Do not touch reserved tiles (khaje EAST/SOUTH MMIO hangs).
+ */
+static void msm_gpio_irq_quiesce(struct msm_pinctrl *pctrl)
+{
+	const struct msm_pingroup *g;
+	unsigned int i, ngpio = pctrl->soc->ngpios;
+	unsigned long flags;
+	u32 val;
+
+	for (i = 0; i < ngpio; i++) {
+		if (msm_gpio_is_reserved(pctrl, i))
+			continue;
+
+		g = &pctrl->soc->groups[i];
+		if (g->intr_detection_width != 1 &&
+		    g->intr_detection_width != 2)
+			continue;
+
+		raw_spin_lock_irqsave(&pctrl->lock, flags);
+		val = msm_readl_intr_cfg(pctrl, g);
+		val &= ~BIT(g->intr_enable_bit);
+		val &= ~BIT(g->intr_raw_status_bit);
+		msm_writel_intr_cfg(val, pctrl, g);
+		msm_ack_intr_status(pctrl, g);
+		raw_spin_unlock_irqrestore(&pctrl->lock, flags);
+	}
+}
+
 static int msm_gpio_init(struct msm_pinctrl *pctrl)
 {
 	struct gpio_chip *chip;
@@ -1440,19 +1489,23 @@ static int msm_gpio_init(struct msm_pinctrl *pctrl)
 		}
 	}
 
-	girq = &chip->irq;
-	gpio_irq_chip_set_chip(girq, &msm_gpio_irq_chip);
-	girq->parent_handler = msm_gpio_irq_handler;
-	girq->fwnode = dev_fwnode(pctrl->dev);
-	girq->num_parents = 1;
-	girq->parents = devm_kcalloc(pctrl->dev, 1, sizeof(*girq->parents),
-				     GFP_KERNEL);
-	if (!girq->parents)
-		return -ENOMEM;
-	girq->default_type = IRQ_TYPE_NONE;
-	girq->handler = handle_bad_irq;
-	girq->parents[0] = pctrl->irq;
-	girq->init_valid_mask = msm_gpio_irq_init_valid_mask;
+	if (pctrl->irq >= 0) {
+		msm_gpio_irq_quiesce(pctrl);
+
+		girq = &chip->irq;
+		gpio_irq_chip_set_chip(girq, &msm_gpio_irq_chip);
+		girq->parent_handler = msm_gpio_irq_handler;
+		girq->fwnode = dev_fwnode(pctrl->dev);
+		girq->num_parents = 1;
+		girq->parents = devm_kcalloc(pctrl->dev, 1, sizeof(*girq->parents),
+					     GFP_KERNEL);
+		if (!girq->parents)
+			return -ENOMEM;
+		girq->default_type = IRQ_TYPE_NONE;
+		girq->handler = handle_bad_irq;
+		girq->parents[0] = pctrl->irq;
+		girq->init_valid_mask = msm_gpio_irq_init_valid_mask;
+	}
 
 	ret = devm_gpiochip_add_data(pctrl->dev, &pctrl->chip, pctrl);
 	if (ret) {
@@ -1581,9 +1634,10 @@ int msm_pinctrl_probe(struct platform_device *pdev,
 
 	msm_pinctrl_setup_pm_reset(pctrl);
 
-	pctrl->irq = platform_get_irq(pdev, 0);
-	if (pctrl->irq < 0)
-		return pctrl->irq;
+	/* Optional: rain/khaje bisect — pinmux without summary IRQ (irq storm / BACK_FB). */
+	pctrl->irq = platform_get_irq_optional(pdev, 0);
+	if (pctrl->irq == -EPROBE_DEFER)
+		return -EPROBE_DEFER;
 
 	pctrl->desc.owner = THIS_MODULE;
 	pctrl->desc.pctlops = &msm_pinctrl_ops;
@@ -1607,13 +1661,17 @@ int msm_pinctrl_probe(struct platform_device *pdev,
 			return ret;
 	}
 
-	ret = msm_gpio_init(pctrl);
-	if (ret)
-		return ret;
+	ret = 0;
+	if (soc_data->ngpios) {
+		ret = msm_gpio_init(pctrl);
+		if (ret)
+			return ret;
+	}
 
 	platform_set_drvdata(pdev, pctrl);
 
-	dev_dbg(&pdev->dev, "Probed Qualcomm pinctrl driver\n");
+	dev_info(&pdev->dev, "Probed Qualcomm pinctrl (irq=%d ngpios=%u)\n",
+		 pctrl->irq, soc_data->ngpios);
 
 	return 0;
 }
