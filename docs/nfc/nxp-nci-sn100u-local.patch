+/*
+ * NXP proprietary activation command (PROP_ACT, OID=0x02).
+ * Must be sent after CORE_INIT to enable NXP proprietary extensions
+ * and activate the RF subsystem. Without this, RF discovery yields
+ * no usable data path on NXP NCI 2.0 controllers (SN100U, PN7150).
+ */
+#define NXP_NCI_PROP_ACT_CMD nci_opcode_pack(NCI_GID_PROPRIETARY, 0x02)
+
+/*
+ * NCI config frames captured verbatim from stock Android
+ * (NFCSNOOP_LOG dump) during NFC-on on the SN100U: GID-2 NFCEE
+ * discover frames, the 3-byte GID-3 proprietary frames and the
+ * GID-0 SET_CONFIG/GET_CONFIG frames that arm the proprietary
+ * MIFARE interface.  The 0x21 RF-management frames from the same
+ * capture (RF_DISCOVER/RF_DEACTIVATE/RF poll config) are NOT
+ * replayed here: they would start RF discovery before the kernel
+ * issues its own RF_DISCOVER_MAP and the map request then fails
+ * with NCI_STATUS_SEMANTIC_ERROR.  Those frames are handled by the
+ * pre/post_discover hooks instead.
+ */
