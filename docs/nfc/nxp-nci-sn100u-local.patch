+	0x22, 0x00, 0x00, 0x03, 0x00, 0x05, 0x03, 0x00, 0x02, 0x03, 0x00, 0x05,
+	0x03, 0x00, 0x02, 0x03, 0x00, 0x03, 0x03, 0x00, 0x0a, 0x22, 0x01, 0x02,
+	0x80, 0x01, 0x03, 0x00, 0x03, 0x03, 0x00, 0x03, 0x03, 0x00, 0x03, 0x03,
+	0x00, 0x06, 0x20, 0x03, 0x03, 0x01, 0xa0, 0xf0, 0x20, 0x03, 0x03, 0x01,
+	0xa0, 0x07, 0x20, 0x03, 0x03, 0x01, 0xa0, 0x44, 0x20, 0x03, 0x02, 0x01,
+	0x52, 0x20, 0x03, 0x03, 0x01, 0xa0, 0xf0, 0x20, 0x02, 0x04, 0x01, 0x02,
+	0x01, 0x00, 0x20, 0x09, 0x01, 0x02, 0x20, 0x02, 0x0a, 0x03, 0x32, 0x01,
+	0x20, 0x38, 0x01, 0x01, 0x50, 0x01, 0x00,
+};
+static const u8 nxp_sn100u_init_lens[] = {
+	3, 3, 3, 3, 3, 3, 3, 5, 3, 3, 3, 3, 6, 6, 6, 5, 6, 7, 4, 13,
+};
+
+/*
+ * Exact per-poll sequence stock Android emits before its final
+ * 7-tech RF_DISCOVER (NFCSNOOP_LOG): two proprietary-only
+ * RF_DISCOVERs (0x80/0x81) each followed by RF_DEACTIVATE, the
+ * 99-byte RF poll configuration (0x21 0x01 0x60, poll-tech AID
+ * TLVs) and a SET_CONFIG.  These frames "arm" the proprietary
+ * MIFARE poll techs so the card is discovered with rf_protocol
+ * 0x80 and the follow-up RF_DISCOVER_SELECT succeeds; without
+ * them the select fails with NCI_STATUS_DISCOVERY_TARGET_
+ * ACTIVATION_FAILED (0xa1).
+ */
+static const u8 nxp_sn100u_pre_disc_blob[] = {
+	0x21, 0x03, 0x05, 0x02, 0x80, 0x01, 0x81, 0x01, 0x21, 0x06, 0x01, 0x00,
+	0x21, 0x01, 0x60,0x00,0x08,0x02,0x10,0x00,0x11,0x32,0x50,0x41,0x59,0x2e,0x53,0x59,0x53,0x2e,0x44,0x44,0x46,0x30,0x31,0x02,0x0f,0x00,0x11,0xa0,0x00,0x00,0x08,0x09,0x43,0x43,0x43,0x44,0x4b,0x46,0x76,0x31,0x02,0x07,0x00,0x11,0xf0,0x00,0x00,0xfe,0x2c,0x02,0x0c,0x00,0x11,0x4f,0x53,0x45,0x2e,0x56,0x41,0x53,0x2e,0x30,0x31,0x02,0x0b,0x00,0x11,0xa0,0x00,0x00,0x04,0x76,0xd0,0x00,0x01,0x11,0x02,0x0a,0x00,0x11,0xa0,0x00,0x00,0x06,0x47,0x2f,0x00,0x02,0x03,0x04,0x00,0x11,0xfe,0xfe,0x01,0x03,0x00,0x01,0x05,
+	0x20, 0x02, 0x07, 0x02, 0x32, 0x01, 0x20, 0x38, 0x01, 0x01,
+	0x21, 0x03, 0x05, 0x02, 0x80, 0x01, 0x81, 0x01, 0x21, 0x06, 0x01, 0x00,
+	0x20, 0x02, 0x17, 0x01, 0x29, 0x14, 0x46, 0x66, 0x6d, 0x01, 0x01, 0x12,
+	0x02, 0x02, 0x07, 0xff, 0x03, 0x02, 0x00, 0x03, 0x04, 0x01, 0x64, 0x07,
+	0x01, 0x03,
+	0x20, 0x02, 0x07, 0x02, 0x32, 0x01, 0x20, 0x38, 0x01, 0x01,
+};
+static const u8 nxp_sn100u_pre_disc_lens[] = { 8, 4, 99, 10, 8, 4, 26, 10 };
+
+static const u8 nxp_sn100u_post_disc_blob[] = {
+	0x20, 0x09, 0x01, 0x00, 0x20, 0x02, 0x04, 0x01, 0x02, 0x01, 0x01,
+};
+static const u8 nxp_sn100u_post_disc_lens[] = { 4, 7 };
+
+static void nxp_nci_send_raw_seq(struct nci_dev *ndev,
+				 const u8 *blob, const u8 *lens,
+				 unsigned int n)
+{
+	struct sk_buff *skb;
+	unsigned int off = 0, i;
+
+	for (i = 0; i < n; i++) {
+		skb = nci_skb_alloc(ndev, lens[i], GFP_KERNEL);
+		if (!skb)
+			return;
+		skb_put_data(skb, blob + off, lens[i]);
+		off += lens[i];
+		skb_queue_tail(&ndev->cmd_q, skb);
+	}
+	queue_work(ndev->cmd_wq, &ndev->cmd_work);
+}
+
+/*
+ * Direct variant for the init replay: several init frames (the
+ * 3-byte GID-3 commands) are answered only by notifications/data
+ * packets, never by an RSP, so they would stall the cmd_q
+ * lockstep.  Send them straight to the transport instead; post_setup
+ * runs in process context with no request pending, so the async
+ * responses are harmless.
+ */
+static void nxp_nci_send_raw_seq_direct(struct nci_dev *ndev,
+					const u8 *blob, const u8 *lens,
+					unsigned int n)
+{
+	struct sk_buff *skb;
+	unsigned int off = 0, i;
+
+	for (i = 0; i < n; i++) {
+		skb = nci_skb_alloc(ndev, lens[i], GFP_KERNEL);
+		if (!skb)
+			return;
+		skb_put_data(skb, blob + off, lens[i]);
+		off += lens[i];
+		ndev->ops->send(ndev, skb);
+		msleep(30);
+	}
+}
+
+static void nxp_nci_pre_discover(struct nci_dev *ndev, __u32 im_protocols)
+{
+	if (!(im_protocols & NFC_PROTO_MIFARE_MASK))
+		return;
+	nxp_nci_send_raw_seq(ndev, nxp_sn100u_pre_disc_blob,
+			     nxp_sn100u_pre_disc_lens,
+			     ARRAY_SIZE(nxp_sn100u_pre_disc_lens));
+}
+
+static void nxp_nci_post_discover(struct nci_dev *ndev)
+{
+	nxp_nci_send_raw_seq(ndev, nxp_sn100u_post_disc_blob,
+			     nxp_sn100u_post_disc_lens,
+			     ARRAY_SIZE(nxp_sn100u_post_disc_lens));
+}
+
+/*
+ * Stock Android polls MIFARE on the SN100U with the proprietary
+ * poll techs only: "21 03 05 02 80 01 81 01".  The card is then
+ * discovered with rf_protocol 0x80 and the follow-up
+ * RF_DISCOVER_SELECT (rf_protocol 0x80 / rf_interface FRAME)
+ * succeeds; with the generic tech list the card is found through
+ * NFC-A passive poll instead and the proprietary select fails
+ * with NCI_STATUS_DISCOVERY_TARGET_ACTIVATION_FAILED (0xa1).
+ */
+static int nxp_nci_discover_configs(struct nci_dev *ndev,
+				    __u32 im_protocols, __u32 tm_protocols,
+				    struct nci_rf_disc_cmd *cmd)
+{
+	/*
+	 * Stock Android arms the SN100U proprietary poll techs with two
+	 * RF_DISCOVER (0x80/0x81 only) frames sent from pre_discover,
+	 * then issues the regular 7-tech RF_DISCOVER itself.  The core
+	 * default list already matches that final frame, so no override
+	 * is needed here.
+	 */
+	return 0;
+}
+
+static int nxp_sn100u_seq_enable = 1;
+module_param_named(seq_enable, nxp_sn100u_seq_enable, int, 0644);
+MODULE_PARM_DESC(seq_enable,
+		 " replay the stock Android SN100U init sequence");
+
+static int nxp_nci_mfc_raw = 1;
+module_param_named(mfc_raw, nxp_nci_mfc_raw, int, 0644);
+MODULE_PARM_DESC(mfc_raw,
+		 " activate MIFARE targets on the SN100U proprietary "
+		 "RF protocol/interface 0x80 (frame I/F) like stock Android");
+
+static int nxp_nci_post_setup(struct nci_dev *ndev)
+{
+	/*
+	 * Replay the stock Android init sequence once per open: the
+	 * controller drops this config on every CORE_RESET/INIT, so it
+	 * must be resent on every open — a once-per-boot replay leaves
+	 * the proprietary 0x80 MIFARE interface disabled.
+	 */
+	if (nxp_sn100u_seq_enable)
+		nxp_nci_send_raw_seq_direct(ndev, nxp_sn100u_init_blob,
+					    nxp_sn100u_init_lens,
+					    ARRAY_SIZE(nxp_sn100u_init_lens));
+
+	return 0;
+}
+
+static int nxp_nci_prop_act_rsp(struct nci_dev *ndev, struct sk_buff *skb)
+{
+	u8 status = skb->data[0];
+
+	nci_req_complete(ndev, status);
+	return 0;
+}
+
+static const struct nci_driver_ops nxp_nci_prop_ops[] = {
+	{
+		.opcode = NXP_NCI_PROP_ACT_CMD,
+		.rsp = nxp_nci_prop_act_rsp,
+	},
+};
+
+/*
+ * Stock Android selects MIFARE targets with rf_protocol=0x80 /
+ * rf_interface=0x80 (NXP proprietary MIFARE frame I/F), on which the
+ * controller understands the '40 <sector> <flags> [key]' auth and
+ * '10 <mifare frame>' command wrappers used by NxpMfcReader.  With the
+ * standard T2T/FRAME selection the SN100U accepts data packets but
+ * never produces a DATA_PKT response.
+ *
+ * NXP proprietary poll protocols used for MIFARE on the SN100U:
+ * stock Android discovers MIFARE targets on tech_and_mode 0x80/0x81
+ * and activates them with rf_protocol 0x80 on the proprietary
+ * interface (rf_interface 0x80), where the '40'/'10' frame wrappers
+ * work.  Report them as MIFARE so the generic NCI core accepts the
+ * targets.
+ */
+static __u32 nxp_nci_get_rfprotocol(struct nci_dev *ndev,
+				    __u8 rf_protocol)
+{
+	if (rf_protocol == 0x80 || rf_protocol == 0x81)
+		return NFC_PROTO_MIFARE_MASK;
+	return 0;
+}
+
+static void nxp_nci_rf_select_iface(struct nci_dev *ndev,
+				    struct nci_rf_discover_select_cmd *cmd)
+{
+	/*
+	 * Stock Android selects MIFARE with rf_protocol=0x80 but keeps
+	 * rf_interface=0x01 (FRAME): the wire frame is
+	 * "21 04 03 01 80 01".  Setting rf_interface=0x80 makes the
+	 * SN100U reject the activation with status 0xa1.
+	 */
+	if (nxp_nci_mfc_raw &&
+	    cmd->rf_protocol == NCI_RF_PROTOCOL_T2T) {
+		cmd->rf_protocol = 0x80;
+		cmd->rf_interface = 0x80;
+	}
+}
+
 static const struct nci_ops nxp_nci_ops = {
 	.open = nxp_nci_open,
 	.close = nxp_nci_close,
 	.send = nxp_nci_send,
+	.post_setup = nxp_nci_post_setup,
 	.fw_download = nxp_nci_fw_download,
+	.get_rfprotocol = nxp_nci_get_rfprotocol,
+	.rf_select_iface = nxp_nci_rf_select_iface,
+	.pre_discover = nxp_nci_pre_discover,
+	.post_discover = nxp_nci_post_discover,
+	.discover_configs = nxp_nci_discover_configs,
+	.prop_ops = nxp_nci_prop_ops,
+	.n_prop_ops = ARRAY_SIZE(nxp_nci_prop_ops),
 	.core_ops = nxp_nci_core_ops,
 	.n_core_ops = ARRAY_SIZE(nxp_nci_core_ops),
 };
