+		 "RF protocol/interface 0x80 (frame I/F) like stock Android");
+
+/*
+ * Stock Android selects MIFARE targets with rf_protocol=0x80 /
+ * rf_interface=0x80 (NXP proprietary MIFARE frame I/F), on which the
+ * controller understands the '40 <sector> <flags> [key]' auth and
+ * '10 <mifare frame>' command wrappers used by NxpMfcReader.  With the
+ * standard T2T/FRAME selection the SN100U accepts data packets but
+ * never produces a DATA_PKT response.
+ */
+static void nxp_nci_rf_select_iface(struct nci_dev *ndev,
+				    struct nci_rf_discover_select_cmd *cmd)
+{
+	if (nxp_nci_mfc_raw &&
+	    cmd->rf_protocol == NCI_RF_PROTOCOL_T2T) {
+		cmd->rf_protocol = 0x80;
+		cmd->rf_interface = 0x80;
+	}
+}
